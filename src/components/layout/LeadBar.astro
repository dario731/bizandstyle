---
/**
 * LeadBar — slim sticky bottom bar with one action. Opens the contact panel.
 */
---

<div class="lb ground-onyx" data-leadbar aria-label="Contact">
  <div class="container lb__inner">
    <p class="lb__text">
      <span class="lb__dot" aria-hidden="true"></span>
      <span>Business. Wealth. Lifestyle. — Miami</span>
    </p>
    <div class="lb__actions">
      <button class="btn lb__view" type="button" data-lb-view hidden>0 selected · View</button>
      <a class="btn btn--flash lb__cta" href="/build" data-lb-cta data-track="cta_click" data-track-cta-name="build_journey" data-track-cta-location="lead_bar">
        Build your journey
      </a>
    </div>
  </div>
</div>

<style>
  .lb {
    position: fixed;
    inset: auto 0 0 0;
    z-index: calc(var(--z-header) - 1);
    background: rgba(12, 13, 15, 0.92);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-top: 1px solid rgba(244, 246, 248, 0.1);
    color: var(--paper);
    transform: translateY(110%);
    transition: transform 0.6s var(--ease-out);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .lb.is-visible {
    transform: translateY(0);
  }

  .lb__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 3.75rem;
  }

  .lb__text {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .lb__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brass);
    box-shadow: 0 0 0 0 rgba(245, 247, 249, 0.7);
    animation: lb-pulse 1.6s ease-out infinite;
  }

  @keyframes lb-pulse {
    to { box-shadow: 0 0 0 12px rgba(245, 247, 249, 0); }
  }

  .lb__actions {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .lb__cta,
  .lb__view {
    min-height: 2.5rem;
    padding: 0.55em 1.2em;
    justify-content: center;
  }

  @media (max-width: 720px) {
    .lb__text { display: none; }
    .lb__inner { justify-content: stretch; }
    .lb__actions { width: 100%; }
    .lb__actions .btn { flex: 1 1 0; padding-inline: 0.6em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb { transition: none; }
    .lb__dot { animation: none; }
  }
</style>

<style is:global>
  body.has-leadbar {
    padding-bottom: 4rem;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-leadbar]');
  if (bar) {
    document.body.classList.add('has-leadbar');
    const show = () => bar.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.4);
    window.addEventListener('scroll', show, { passive: true });
    show();
  }
</script>
