---
/**
 * LeadBar — slim sticky bottom bar with one action. Opens the contact panel.
 */
---

<div class="lb ground-onyx" data-leadbar aria-label="Contact">
  <div class="container lb__inner">
    <p class="lb__text">
      <span class="lb__dot" aria-hidden="true"></span>
      <span>Business. Wealth. Lifestyle. — Miami</span>
    </p>
    <button class="btn btn--flash lb__cta" type="button" data-open-contact="message" data-track="cta_click" data-track-cta-name="start_conversation" data-track-cta-location="lead_bar">
      Start a conversation
    </button>
  </div>
</div>

<style>
  .lb {
    position: fixed;
    inset: auto 0 0 0;
    z-index: calc(var(--z-header) - 1);
    background: rgba(11, 14, 19, 0.92);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-top: 1px solid rgba(244, 246, 248, 0.1);
    color: var(--paper);
    transform: translateY(110%);
    transition: transform 0.6s var(--ease-out);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .lb.is-visible {
    transform: translateY(0);
  }

  .lb__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 3.75rem;
  }

  .lb__text {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .lb__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--brass);
    box-shadow: 0 0 0 0 rgba(142, 197, 232, 0.7);
    animation: lb-pulse 1.6s ease-out infinite;
  }

  @keyframes lb-pulse {
    to { box-shadow: 0 0 0 12px rgba(142, 197, 232, 0); }
  }

  .lb__cta {
    min-height: 2.5rem;
    padding: 0.55em 1.2em;
  }

  @media (max-width: 720px) {
    .lb__text { display: none; }
    .lb__inner { justify-content: stretch; }
    .lb__cta { width: calc(100% - 3.2rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .lb { transition: none; }
    .lb__dot { animation: none; }
  }
</style>

<style is:global>
  body.has-leadbar {
    padding-bottom: 4rem;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-leadbar]');
  if (bar) {
    document.body.classList.add('has-leadbar');
    const show = () => bar.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.4);
    window.addEventListener('scroll', show, { passive: true });
    show();
  }
</script>
