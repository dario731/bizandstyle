---
/**
 * FloatingContacts — the single WhatsApp pill at bottom right (silver, halo).
 */
import { site } from '@data/site';
const wa = `https://wa.me/${site.phoneHref.replace(/\D/g, '')}?text=${encodeURIComponent("Hi BIZ & STYLE — I'd like to talk about what I'm building.")}`;
---

<div class="fc" data-floating-contacts aria-label="Quick contact">
  <a class="fc__btn fc__btn--wa" href={wa} target="_blank" rel="noopener" aria-label="WhatsApp" data-track="whatsapp_click" data-track-cta-location="floating">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.885-9.885 9.885m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
    <span class="fc__label">WhatsApp</span>
    <span class="fc__halo" aria-hidden="true"></span>
  </a>
</div>

<style>
  .fc {
    position: fixed;
    right: max(var(--gutter), env(safe-area-inset-right));
    bottom: calc(4.75rem + env(safe-area-inset-bottom));
    z-index: calc(var(--z-header) - 1);
    display: grid;
    gap: 0.5rem;
    justify-items: end;
  }

  .fc__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 3.25rem;
    padding: 0 1.1rem 0 0.9rem;
    border-radius: 999px;
    background: rgba(15, 19, 25, 0.92);
    border: 1px solid rgba(244, 246, 248, 0.18);
    color: var(--paper);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
    transition: transform var(--dur-2) var(--ease-out), border-color 0.2s, background 0.2s;
  }

  .fc__btn svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
  }

  .fc__label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fc__halo {
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    border: 1px solid rgba(211, 217, 225, 0.6);
    animation: fc-halo 2.2s ease-out infinite;
    pointer-events: none;
  }

  @keyframes fc-halo {
    0% { transform: scale(1); opacity: 0.9; }
    100% { transform: scale(1.35); opacity: 0; }
  }

  .fc__btn:hover {
    transform: translateX(-3px);
    border-color: var(--brass);
  }

  .fc__btn--wa {
    background: var(--silver-grad);
    border-color: transparent;
    color: var(--onyx);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45), 0 1px 0 rgba(255, 255, 255, 0.5) inset;
  }
  .fc__btn--wa svg { width: 1.45rem; height: 1.45rem; }
  .fc__btn--wa:hover { background: var(--silver-grad-hover); border-color: transparent; }

  .fc__btn--chat {
    background: var(--brass);
    border-color: var(--brass);
    color: var(--onyx);
  }

  .fc__pulse {
    position: absolute;
    inset: -1px;
    border-radius: 2px;
    box-shadow: 0 0 0 0 rgba(211, 217, 225, 0.6);
    animation: fc-pulse 2s ease-out infinite;
    pointer-events: none;
  }

  @keyframes fc-pulse {
    70% { box-shadow: 0 0 0 12px rgba(211, 217, 225, 0); }
    100% { box-shadow: 0 0 0 0 rgba(211, 217, 225, 0); }
  }

  @media (max-width: 720px) {
    .fc { bottom: calc(4.5rem + env(safe-area-inset-bottom)); right: 0.75rem; gap: 0.4rem; }
    .fc__btn { height: 3.4rem; width: 3.4rem; padding: 0; justify-content: center; }
    .fc__label { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fc__pulse { animation: none; }
  }
</style>
