---
/**
 * GlobalHeader — solid Onyx sticky bar. Flat navigation: every item is a
 * direct link (no dropdowns). "Let's connect" pulses and opens the contact
 * panel. Mobile: three-line menu opening a full-screen list.
 */
import { localePath, published } from '@i18n/index';
import { site, type Locale } from '@data/site';

interface Props {
  locale?: Locale;
  overlay?: boolean;
}
const { locale = 'en' } = Astro.props;
const current = Astro.url.pathname;
const items = [
  { label: 'Platform', href: '/platform' },
  { label: 'Solutions', href: '/solutions' },
  { label: 'Divisions', href: '/divisions' },
  { label: 'Investor Journey™', href: '/investor-journey' },
  { label: 'Why Miami', href: '/miami' },
  { label: 'Insights', href: '/insights' },
  { label: 'About', href: '/about' },
];
const isActive = (href: string) => current === href || current.startsWith(href + '/') || (href === '/divisions' && /^\/(advisory|commerce|luxury)/.test(current));
---

<header class="hdr" data-header>
  <div class="hdr__bar">
    <div class="container hdr__inner">
      <a class="hdr__logo" href={localePath('/', locale)} aria-label={`${site.name} — home`} data-track="navigation_click" data-track-cta-name="logo">
        <img src="/brand/wordmark-white.svg" alt="" width="128" height="28" decoding="async" fetchpriority="high" />
      </a>

      <nav class="hdr__nav" aria-label="Primary">
        <ul role="list">
          {
            items.map((item) => (
              <li>
                <a class:list={['hdr__link', { 'is-active': isActive(item.href) }]} href={localePath(item.href, locale)} aria-current={isActive(item.href) ? 'page' : undefined} data-track="navigation_click" data-track-cta-name={item.label}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="hdr__actions">
        {
          published.length > 1 && (
            <div class="hdr__lang">
              {published.map((l) => (
                <a href={localePath(current.replace(/^\/(it|es|pt)(?=\/|$)/, '') || '/', l)} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined} data-track="language_change" data-track-language={l}>
                  {site.locales[l].short}
                </a>
              ))}
            </div>
          )
        }
        <button class="btn btn--flash hdr__cta" type="button" data-open-contact="message" data-track="cta_click" data-track-cta-name="lets_connect" data-track-cta-location="header">
          Let's connect
        </button>
        <button class="btn btn--flash hdr__cta-m" type="button" data-open-contact="message" data-track="cta_click" data-track-cta-name="lets_connect" data-track-cta-location="header_mobile">Let's connect</button>
        <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-mobile-trigger>
          <span class="sr-only">Menu</span>
          <span class="hdr__burger-line"></span>
          <span class="hdr__burger-line"></span>
          <span class="hdr__burger-line"></span>
        </button>
      </div>
    </div>
  </div>

  <div class="mob" id="mobile-menu" data-mobile hidden>
    <div class="mob__inner">
      <ul role="list" class="mob__list">
        {
          items.map((item, i) => (
            <li class="mob__item" style={`--i:${i}`}>
              <a class="mob__link" href={localePath(item.href, locale)}>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mob__foot">
        <button class="btn btn--flash" type="button" data-open-contact="message">Let's connect</button>
        <a class="btn" href="/build">Build your journey</a>
        <div class="mob__contact small">
          <a href={`mailto:${site.email}`} data-track="email_click">{site.email}</a>
          <a href={site.phoneHref} data-track="phone_click">{site.phone}</a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    --hdr-h: 4.5rem;
  }

  .hdr__bar {
    position: relative;
    z-index: 2;
    height: var(--hdr-h);
    color: #fff;
    background: rgba(12, 13, 15, 0.94);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(244, 246, 248, 0.08);
  }

  .hdr__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .hdr__logo {
    flex: none;
    display: block;
  }

  .hdr__logo img {
    width: auto;
    height: 26px;
  }

  .hdr__nav {
    margin-inline: auto;
    display: none;
  }

  .hdr__nav ul {
    display: flex;
    gap: clamp(0.9rem, 1.6vw, 1.6rem);
  }

  .hdr__link {
    display: inline-block;
    white-space: nowrap;
    padding: 0.5rem 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    background-image: linear-gradient(var(--brass), var(--brass));
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: 0 100%;
    transition: background-size var(--dur-2) var(--ease-out), color var(--dur-1);
  }

  .hdr__link:hover,
  .hdr__link.is-active {
    background-size: 100% 2px;
  }

  .hdr__link.is-active {
    color: var(--brass);
  }

  .hdr__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .hdr__lang {
    display: none;
    gap: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hdr__lang a[aria-current='true'] {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .hdr__cta {
    display: none;
    min-height: 2.6rem;
    padding: 0.6em 1.2em;
    gap: 0.6em;
  }

  .hdr__cta-m {
    min-height: 2.5rem;
    padding: 0.5em 0.9em;
    font-size: 0.66rem;
  }

  .hdr__burger {
    display: grid;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    place-content: center;
    border: 1px solid rgba(244, 246, 248, 0.25);
    border-radius: 2px;
  }

  .hdr__burger-line {
    display: block;
    width: 20px;
    height: 2px;
    background: currentColor;
    transition: transform var(--dur-2) var(--ease-out), opacity var(--dur-1);
  }

  .hdr__burger[aria-expanded='true'] .hdr__burger-line:nth-child(2) {
    transform: translateY(7px) rotate(45deg);
  }

  .hdr__burger[aria-expanded='true'] .hdr__burger-line:nth-child(3) {
    opacity: 0;
  }

  .hdr__burger[aria-expanded='true'] .hdr__burger-line:nth-child(4) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* --- mobile menu --- */
  .mob {
    position: fixed;
    inset: var(--hdr-h) 0 0 0;
    z-index: 1;
    background: var(--onyx);
    color: var(--paper);
    overflow: auto;
  }

  .mob__inner {
    min-height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: var(--space-6) var(--gutter) var(--space-8);
  }

  .mob__list {
    display: grid;
  }

  .mob__item {
    border-bottom: 1px solid rgba(244, 246, 248, 0.1);
    opacity: 0;
    transform: translateY(12px);
    animation: mob-in 0.5s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 45ms);
  }

  @keyframes mob-in {
    to { opacity: 1; transform: none; }
  }

  .mob__link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 112, 'wght' 650;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .mob__foot {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-6);
  }

  .mob__contact {
    display: grid;
    gap: 0.3rem;
    color: var(--stone);
    margin-top: var(--space-3);
  }

  @media (min-width: 1100px) {
    .hdr__nav { display: block; }
    .hdr__cta { display: inline-flex; }
    .hdr__burger { display: none; }
    .hdr__cta-m { display: none; }
    .hdr__lang { display: flex; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const burger = header.querySelector<HTMLButtonElement>('[data-mobile-trigger]')!;
    const mobile = header.querySelector<HTMLElement>('[data-mobile]')!;
    const toggle = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      mobile.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      header.classList.toggle('is-menu-open', open);
    };
    burger.addEventListener('click', () => toggle(mobile.hidden));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !mobile.hidden) toggle(false); });
    mobile.querySelectorAll('a, button').forEach((a) => a.addEventListener('click', () => toggle(false)));
  }
</script>
