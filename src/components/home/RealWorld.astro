---
/**
 * "Built in the real world" — a scroll-built LargeStatement (lines light as the
 * reader scrolls) followed by the operating-proof strip.
 */
import type { Copy } from '@i18n/en';
interface Props {
  copy: Copy['home']['realWorld'];
}
const { copy } = Astro.props;
---

<section class="section ground-onyx rw" id="real-world" aria-labelledby="rw-title">
  <div class="container">
    <p class="eyebrow eyebrow--marker" data-reveal>{copy.eyebrow}</p>

    <div class="rw__stage" data-statement>
      <h2 id="rw-title" class="display rw__statement">
        {copy.lines.map((l, i) => <span class:list={['rw__line', { 'rw__line--lead': i === 0, 'rw__line--close': i === copy.lines.length - 1 }]} data-line={i}>{l}</span>)}
      </h2>
    </div>

    <div class="rw__grid">
      <p class="prose rw__body" data-reveal>{copy.body}</p>
      <div class="rw__proof" data-reveal>
        <p class="eyebrow">{copy.proofEyebrow}</p>
        <dl class="rw__list" data-reveal-group>
          {copy.proof.map((p) => (
            <div class="rw__row">
              <dt>{p.k}</dt>
              <dd>{p.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .rw__stage {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(4rem, 10vw, 8rem);
  }

  .rw__statement {
    display: grid;
    gap: 0.05em;
  }

  .rw__line {
    display: block;
    color: var(--rule-deep);
    transition: color var(--dur-3) var(--ease-out), transform var(--dur-3) var(--ease-out);
    transform: translateX(0);
  }

  .rw__line--lead {
    color: var(--paper);
    margin-bottom: 0.3em;
  }

  .rw__line.is-lit {
    color: var(--paper);
  }

  .rw__line--close {
    --wght-display: 300;
    font-variation-settings: 'wdth' var(--wdth-display), 'wght' 300;
    font-weight: 300;
    margin-top: 0.3em;
  }

  .rw__line--close.is-lit {
    color: var(--brass);
  }

  .rw__grid {
    display: grid;
    gap: var(--space-8);
    border-top: 1px solid var(--rule-deep);
    padding-top: var(--space-7);
  }

  .rw__body {
    color: var(--stone);
  }

  .rw__proof .eyebrow {
    margin-bottom: var(--space-5);
    color: var(--stone);
  }

  .rw__list {
    display: grid;
  }

  .rw__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding: 0.85rem 0;
    border-top: 1px solid var(--rule-deep);
    font-size: 0.95rem;
  }

  .rw__row:last-child {
    border-bottom: 1px solid var(--rule-deep);
  }

  .rw__row dt {
    color: var(--paper);
  }

  .rw__row dd {
    color: var(--stone);
    text-align: right;
  }

  @media (min-width: 1024px) {
    .rw__grid {
      grid-template-columns: 5fr 6fr;
      column-gap: calc(var(--gutter) * 2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rw__line { color: var(--paper); }
    .rw__line--close { color: var(--brass); }
  }
</style>

<script>
  import { onScrollProgress, reducedMotion } from '@lib/reveal';
  document.querySelectorAll<HTMLElement>('[data-statement]').forEach((stage) => {
    const lines = Array.from(stage.querySelectorAll<HTMLElement>('[data-line]'));
    if (reducedMotion()) {
      lines.forEach((l) => l.classList.add('is-lit'));
      return;
    }
    onScrollProgress(stage, (p) => {
      // light lines between 25% and 75% of the stage's travel through the viewport
      const t = Math.min(1, Math.max(0, (p - 0.28) / 0.42));
      const lit = Math.round(t * (lines.length - 1));
      lines.forEach((l, i) => l.classList.toggle('is-lit', i <= lit));
    });
  });
</script>
