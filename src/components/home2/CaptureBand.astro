---
/**
 * CaptureBand — the homepage close. Persona doors into /tell-us, over footage.
 */
import { site } from '@data/site';
const personas = [
  { id: 'international-company', label: 'International company' },
  { id: 'us-company', label: 'U.S. company' },
  { id: 'founder', label: 'Founder / entrepreneur' },
  { id: 'consumer-brand', label: 'Consumer brand' },
  { id: 'luxury-company', label: 'Luxury company' },
  { id: 'developer', label: 'Developer' },
  { id: 'investor', label: 'Investor' },
  { id: 'partner', label: 'Strategic partner' },
];
---

<section class="cb ground-onyx" id="tell-us" aria-labelledby="cb-title" data-capture>
  <div class="container cb__inner">
    <p class="eyebrow eyebrow--marker" data-cb-reveal>Start here</p>
    <h2 id="cb-title" class="cb__title" data-cb-reveal>
      <span>Tell us</span>
      <span class="thin">what you're building.</span>
    </h2>
    <p class="cb__lede" data-cb-reveal>Every business starts from a different point. Choose yours — the conversation adapts.</p>
    <ul class="cb__doors" role="list" data-cb-doors>
      {
        personas.map((p, i) => (
          <li>
            <a class="cb__door" href={`/tell-us?persona=${p.id}`} data-track="cta_click" data-track-cta-name={`persona_${p.id}`} data-track-cta-location="home_capture">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span>{p.label}</span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="cb__alt" data-cb-reveal>
      <a class="btn btn--solid" href="/tell-us" data-track="cta_click" data-track-cta-name="tell_us" data-track-cta-location="home_capture"><span class="btn__ring" aria-hidden="true"></span>Open the form</a>
      <a class="btn" href={site.calendly} rel="noopener" data-track="calendar_click" data-track-cta-location="home_capture">Book a call</a>
      <a class="link" href={`mailto:${site.email}`} data-track="email_click">{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cb {
    position: relative;
    padding-block: clamp(5rem, 12vh, 9rem);
    overflow: hidden;
    isolation: isolate;
  }

  .cb__inner {
    display: grid;
    gap: var(--space-5);
  }

  .cb__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118, 'wght' 760;
    font-stretch: 118%;
    font-weight: 760;
    font-size: var(--fs-1);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .cb__title span {
    display: block;
  }

  .cb__lede {
    color: var(--stone);
    max-width: 30rem;
  }

  .cb__doors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: var(--space-4);
  }

  .cb__door {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(244, 246, 248, 0.14);
    border-radius: 12px;
    background: rgba(11, 14, 19, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: 0.9rem;
    transition: border-color var(--dur-2), background var(--dur-2), transform var(--dur-2) var(--ease-out);
  }

  .cb__door svg {
    width: 0.9rem;
    height: 0.9rem;
    margin-left: auto;
    opacity: 0.5;
    transition: transform var(--dur-2) var(--ease-out), opacity var(--dur-1);
  }

  .cb__door:hover {
    border-color: var(--brass);
    background: rgba(142, 197, 232, 0.12);
    transform: translateY(-2px);
  }

  .cb__door:hover svg {
    opacity: 1;
    transform: translateX(4px);
  }

  .cb__alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  @media (min-width: 900px) {
    .cb__doors {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { gsap } from '@lib/motion';
  const root = document.querySelector<HTMLElement>('[data-capture]');
  if (root) {
    gsap.from(root.querySelectorAll('[data-cb-reveal]'), { autoAlpha: 0, y: 24, stagger: 0.12, scrollTrigger: { trigger: root, start: 'top 75%' } });
    gsap.from(root.querySelectorAll('[data-cb-doors] li'), { autoAlpha: 0, y: 20, stagger: 0.06, scrollTrigger: { trigger: root.querySelector('[data-cb-doors]'), start: 'top 85%' } });
  }
</script>
