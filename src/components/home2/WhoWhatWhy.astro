---
/**
 * WhoWhatWhy — the three questions every visitor has, answered in one screen,
 * right after the hero. Who we are · What we do · Why partner with us.
 */
const cols = [
  {
    k: 'Who we are',
    title: 'A business development platform in Miami.',
    body: 'Founded in 2017 by Dario Picardi. Three divisions — Advisory, Commerce, Luxury — one team, one infrastructure, one network across the United States, Latin America and Europe.',
    href: '/platform',
    label: 'The platform',
  },
  {
    k: 'What we do',
    title: 'We make companies part of the Americas.',
    body: 'Strategy and market entry, distribution from a bonded hub in Miami, digital acquisition, business development and luxury real estate — for companies, brands, founders and investors.',
    href: '/solutions',
    label: 'Solutions',
  },
  {
    k: 'Why partner with us',
    title: 'Operators, not advisors at a distance.',
    body: 'Everything we offer was built and tested in our own ventures first. The infrastructure already exists. The right expert — licensed where required — is at every stage of the journey.',
    href: '/platform/how-we-work',
    label: 'How we work',
  },
];
---

<section class="www ground-onyx" id="who-what-why" aria-label="Who we are, what we do, why partner with us" data-www>
  <div class="container www__grid">
    {
      cols.map((c, i) => (
        <article class="www__col" data-www-col style={`--i:${i}`}>
          <p class="www__k"><span class="www__idx">0{i + 1}</span>{c.k}</p>
          <h2 class="www__title">{c.title}</h2>
          <p class="www__body">{c.body}</p>
          <a class="link" href={c.href} data-track="navigation_click" data-track-cta-name={c.label}>
            {c.label}<svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
          </a>
          <span class="www__bar" aria-hidden="true"></span>
        </article>
      ))
    }
  </div>
</section>

<style>
  .www {
    padding-block: var(--space-section-sm);
    border-top: 1px solid var(--rule-deep);
  }

  .www__grid {
    display: grid;
    gap: var(--space-5);
  }

  .www__col {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5) var(--space-5) var(--space-6);
    border: 1px solid var(--rule-deep);
    border-radius: 2px;
    background: linear-gradient(160deg, rgba(24, 30, 38, 0.6), rgba(8, 9, 11, 0.6));
    overflow: hidden;
  }

  .www__k {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .www__idx {
    font-family: var(--font-body);
    color: var(--stone);
  }

  .www__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 116, 'wght' 720;
    font-stretch: 116%;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .www__body {
    color: var(--stone);
    font-size: 0.95rem;
  }

  .www__bar {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: linear-gradient(90deg, var(--brass), transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.2s var(--ease-out);
  }

  .www__col.is-in .www__bar {
    transform: scaleX(1);
    transition-delay: calc(var(--i) * 0.15s);
  }

  @media (min-width: 900px) {
    .www__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  import { gsap } from '@lib/motion';
  const root = document.querySelector<HTMLElement>('[data-www]');
  if (root) {
    const cols = root.querySelectorAll<HTMLElement>('[data-www-col]');
    gsap.from(cols, { autoAlpha: 0, y: 30, stagger: 0.15, duration: 1, scrollTrigger: { trigger: root, start: 'top 80%', once: true, onEnter: () => cols.forEach((c) => c.classList.add('is-in')) } });
  }
</script>
