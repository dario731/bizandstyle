---
/**
 * WorldConnect — a dotted world map on canvas. Europe flows into Miami,
 * Miami flows into the Americas. Arcs draw, particles travel, cities light.
 */
---

<section class="wc ground-onyx" id="miami" aria-labelledby="wc-title" data-world>
  <div class="container wc__head">
    <p class="eyebrow eyebrow--marker" data-wc-reveal>Miami · Global reach</p>
    <h2 id="wc-title" class="wc__title" data-wc-reveal>
      <span>Miami is the platform</span>
      <span class="thin">to the Americas.</span>
    </h2>
    <p class="wc__lede" data-wc-reveal>European roots. American execution. Latin American reach — and relationships that extend to Dubai and Singapore. One headquarters, one bonded hub.</p>
  </div>

  <div class="wc__map" data-map-wrap>
    <canvas class="wc__canvas" data-map role="img" aria-label="Animated map: routes connecting Europe, Miami, the United States and Latin America"></canvas>
    <div class="wc__labels" data-labels aria-hidden="true"></div>
  </div>

  <div class="container wc__foot">
    <ul class="wc__routes" role="list" data-wc-routes>
      <li><span class="wc__route-k">Europe</span><span class="wc__route-arrow">→</span><span>Miami</span></li>
      <li><span class="wc__route-k">Miami</span><span class="wc__route-arrow">→</span><span>United States · Canada</span></li>
      <li><span class="wc__route-k">Miami</span><span class="wc__route-arrow">→</span><span>Mexico · Caribbean · Brazil · LATAM</span></li>
      <li><span class="wc__route-k">Miami</span><span class="wc__route-arrow">→</span><span>Dubai · Singapore</span></li>
    </ul>
    <a class="link" href="/miami" data-track="navigation_click" data-track-cta-name="miami">Why Miami<svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></a>
  </div>
</section>

<style>
  .wc {
    position: relative;
    padding-block: clamp(5rem, 12vh, 9rem) clamp(4rem, 8vh, 6rem);
    overflow: hidden;
    isolation: isolate;
  }

  .wc__head {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
  }

  .wc__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118, 'wght' 760;
    font-stretch: 118%;
    font-weight: 760;
    font-size: var(--fs-2);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .wc__title span {
    display: block;
  }

  .wc__lede {
    color: var(--stone);
    max-width: 34rem;
  }

  .wc__map {
    position: relative;
    width: min(100%, 1400px);
    margin: clamp(2rem, 5vh, 4rem) auto 0;
    aspect-ratio: 2.1;
  }

  .wc__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wc__labels :global(span) {
    position: absolute;
    transform: translate(-50%, 8px);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(244, 246, 248, 0.7);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .wc__labels :global(span.is-on) {
    opacity: 1;
  }

  .wc__labels :global(span.is-hub) {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118, 'wght' 760;
    font-size: 0.95rem;
    letter-spacing: 0.16em;
    color: var(--paper);
    transform: translate(-50%, -30px);
  }

  .wc__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    margin-top: clamp(2rem, 5vh, 3.5rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-deep);
  }

  .wc__routes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .wc__route-k {
    color: var(--paper);
  }

  .wc__route-arrow {
    color: var(--brass);
    margin-inline: 0.5rem;
  }

  @media (max-width: 720px) {
    .wc__map { aspect-ratio: 1.15; }
    .wc__labels :global(span.is-minor) { display: none; }
    .wc__labels :global(span) { font-size: 0.52rem; letter-spacing: 0.14em; }
  }
</style>

<script>
  import dots from '@data/world-dots.json';
  import { gsap, reduced } from '@lib/motion';

  const root = document.querySelector<HTMLElement>('[data-world]');
  if (root) {
    gsap.from(root.querySelectorAll('[data-wc-reveal]'), { autoAlpha: 0, y: 24, stagger: 0.12, scrollTrigger: { trigger: root, start: 'top 75%' } });
    gsap.from(root.querySelectorAll('[data-wc-routes] li'), { autoAlpha: 0, y: 12, stagger: 0.1, scrollTrigger: { trigger: root.querySelector('.wc__foot'), start: 'top 90%' } });

    const wrap = root.querySelector<HTMLElement>('[data-map-wrap]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-map]')!;
    const labels = root.querySelector<HTMLElement>('[data-labels]')!;
    const ctx = canvas.getContext('2d')!;

    type City = { id: string; name: string; lon: number; lat: number; hub?: boolean; minor?: boolean };
    const MIAMI: City = { id: 'mia', name: 'Miami', lon: -80.19, lat: 25.76, hub: true };
    const europe: City[] = [
      { id: 'mil', name: 'Milan', lon: 9.19, lat: 45.46 },
      { id: 'lon', name: 'London', lon: -0.13, lat: 51.5, minor: true },
      { id: 'mad', name: 'Madrid', lon: -3.7, lat: 40.4 },
      { id: 'par', name: 'Paris', lon: 2.35, lat: 48.86, minor: true },
    ];
    const global: City[] = [
      { id: 'dxb', name: 'Dubai', lon: 55.27, lat: 25.2 },
      { id: 'sin', name: 'Singapore', lon: 103.82, lat: 1.35 },
    ];
    const americas: City[] = [
      { id: 'nyc', name: 'New York', lon: -74.0, lat: 40.71 },
      { id: 'tor', name: 'Toronto', lon: -79.38, lat: 43.65, minor: true },
      { id: 'lax', name: 'Los Angeles', lon: -118.24, lat: 34.05, minor: true },
      { id: 'mex', name: 'Mexico City', lon: -99.13, lat: 19.43 },
      { id: 'sdq', name: 'Santo Domingo', lon: -69.93, lat: 18.47, minor: true },
      { id: 'pty', name: 'Panama', lon: -79.52, lat: 8.98, minor: true },
      { id: 'bog', name: 'Bogotá', lon: -74.07, lat: 4.71 },
      { id: 'lim', name: 'Lima', lon: -77.04, lat: -12.05, minor: true },
      { id: 'sao', name: 'São Paulo', lon: -46.63, lat: -23.55 },
      { id: 'scl', name: 'Santiago', lon: -70.65, lat: -33.45, minor: true },
      { id: 'bue', name: 'Buenos Aires', lon: -58.38, lat: -34.6, minor: true },
    ];
    type Arc = { from: City; to: City; progress: number; delay: number; particles: number[] };
    const arcs: Arc[] = [
      ...europe.map((c, i) => ({ from: c, to: MIAMI, progress: 0, delay: i * 0.35, particles: [Math.random()] })),
      ...americas.map((c, i) => ({ from: MIAMI, to: c, progress: 0, delay: 1.8 + i * 0.22, particles: [Math.random(), Math.random()] })),
      ...global.map((c, i) => ({ from: MIAMI, to: c, progress: 0, delay: 4.4 + i * 0.5, particles: [Math.random()] })),
    ];

    let W = 0, H = 0;
    let view = { lon0: -132, lon1: 44, latC: 12, scale: 1 };
    const project = (lon: number, lat: number): [number, number] => [(lon - view.lon0) * view.scale, H / 2 - (lat - view.latC) * view.scale * 1.12];

    const labelEls = new Map<string, HTMLSpanElement>();
    const placeLabels = () => {
      for (const c of [MIAMI, ...europe, ...americas, ...global]) {
        let el = labelEls.get(c.id);
        if (!el) {
          el = document.createElement('span');
          el.textContent = c.name;
          if (c.hub) el.classList.add('is-hub', 'is-on');
          if (c.minor) el.classList.add('is-minor');
          labels.appendChild(el);
          labelEls.set(c.id, el);
        }
        const [x, y] = project(c.lon, c.lat);
        el.style.left = `${x}px`;
        el.style.top = `${y}px`;
      }
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = wrap.clientWidth; H = wrap.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      view = W < 720 ? { lon0: -125, lon1: 112, latC: 16, scale: 1 } : { lon0: -132, lon1: 114, latC: 14, scale: 1 };
      view.scale = W / (view.lon1 - view.lon0);
      placeLabels();
    };
    resize();
    window.addEventListener('resize', resize);

    let started = false;
    let t0 = 0;
    const start = () => {
      if (started) return;
      started = true;
      t0 = performance.now();
      arcs.forEach((a) => {
        gsap.to(a, { progress: 1, duration: reduced() ? 0 : 1.6, delay: reduced() ? 0 : a.delay, ease: 'power2.inOut', onComplete: () => labelEls.get(a.to === MIAMI ? a.from.id : a.to.id)?.classList.add('is-on') });
      });
    };

    let running = false;
    new IntersectionObserver((es) => {
      running = es[0].isIntersecting;
      if (running) { start(); requestAnimationFrame(frame); }
    }, { threshold: 0.2 }).observe(wrap);

    const ctrl = (a: [number, number], b: [number, number]): [number, number] => {
      const mx = (a[0] + b[0]) / 2, my = (a[1] + b[1]) / 2;
      const dx = b[0] - a[0], dy = b[1] - a[1];
      const d = Math.hypot(dx, dy) || 1;
      const lift = Math.min(d * 0.28, 220);
      const nx = -dy / d, ny = dx / d;
      const sign = ny < 0 ? 1 : -1;
      return [mx + nx * lift * sign, my + ny * lift * sign];
    };
    const bez = (p0: [number, number], c: [number, number], p1: [number, number], t: number): [number, number] => {
      const u = 1 - t;
      return [u * u * p0[0] + 2 * u * t * c[0] + t * t * p1[0], u * u * p0[1] + 2 * u * t * c[1] + t * t * p1[1]];
    };

    function frame(now: number) {
      if (!running) return;
      const t = (now - t0) / 1000;
      const still = reduced();
      ctx.clearRect(0, 0, W, H);

      for (const [lon, lat] of dots as [number, number][]) {
        if (lon < view.lon0 - 2 || lon > view.lon1 + 2) continue;
        const [x, y] = project(lon, lat);
        if (y < -4 || y > H + 4) continue;
        const shimmer = still ? 0 : Math.sin(t * 0.8 + x * 0.02 + y * 0.03) * 0.05;
        ctx.fillStyle = `rgba(244,246,248,${0.2 + shimmer})`;
        ctx.beginPath(); ctx.arc(x, y, Math.max(0.9, view.scale * 0.19), 0, Math.PI * 2); ctx.fill();
      }

      for (const a of arcs) {
        if (a.progress <= 0) continue;
        const p0 = project(a.from.lon, a.from.lat);
        const p1 = project(a.to.lon, a.to.lat);
        const c = ctrl(p0, p1);
        const inbound = a.to === MIAMI;
        ctx.beginPath();
        ctx.moveTo(p0[0], p0[1]);
        const steps = 48;
        for (let i = 1; i <= steps; i++) {
          const [x, y] = bez(p0, c, p1, (i / steps) * a.progress);
          ctx.lineTo(x, y);
        }
        const g = ctx.createLinearGradient(p0[0], p0[1], p1[0], p1[1]);
        g.addColorStop(0, inbound ? 'rgba(244,246,248,0.25)' : 'rgba(245,247,249,0.9)');
        g.addColorStop(1, inbound ? 'rgba(245,247,249,0.9)' : 'rgba(244,246,248,0.25)');
        ctx.strokeStyle = g;
        ctx.lineWidth = 1.1;
        ctx.stroke();

        const [ex, ey] = bez(p0, c, p1, a.progress);
        ctx.fillStyle = 'rgba(245,247,249,1)';
        ctx.beginPath(); ctx.arc(ex, ey, 2.2, 0, Math.PI * 2); ctx.fill();

        if (a.progress >= 1 && !still) {
          for (let k = 0; k < a.particles.length; k++) {
            a.particles[k] = (a.particles[k] + 0.0035 + k * 0.001) % 1;
            const [px, py] = bez(p0, c, p1, a.particles[k]);
            ctx.shadowBlur = 12; ctx.shadowColor = 'rgba(245,247,249,0.9)';
            ctx.fillStyle = 'rgba(244,246,248,0.95)';
            ctx.beginPath(); ctx.arc(px, py, 1.8, 0, Math.PI * 2); ctx.fill();
            ctx.shadowBlur = 0;
          }
        }
        const target = inbound ? p0 : p1;
        ctx.fillStyle = 'rgba(244,246,248,0.9)';
        ctx.beginPath(); ctx.arc(target[0], target[1], 2, 0, Math.PI * 2); ctx.fill();
      }

      const [mx, my] = project(MIAMI.lon, MIAMI.lat);
      for (let r = 0; r < 3; r++) {
        const ph = still ? 0.5 : (t * 0.5 + r / 3) % 1;
        ctx.strokeStyle = `rgba(245,247,249,${(1 - ph) * 0.6})`;
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.arc(mx, my, 6 + ph * 34, 0, Math.PI * 2); ctx.stroke();
      }
      ctx.fillStyle = '#f5f7f9';
      ctx.shadowBlur = 18; ctx.shadowColor = 'rgba(245,247,249,1)';
      ctx.beginPath(); ctx.arc(mx, my, 5, 0, Math.PI * 2); ctx.fill();
      ctx.shadowBlur = 0;

      requestAnimationFrame(frame);
    }
  }
</script>
