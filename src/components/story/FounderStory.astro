---
import type { Copy } from '@i18n/en';
interface Props {
  copy: Copy['home']['founder'];
  image?: string;
}
const { copy, image = '/media/founder-dario-picardi-tmp.jpg' } = Astro.props;
---

<section class="section ground-onyx founder" id="founder" aria-labelledby="founder-title">
  <div class="container founder__grid">
    <figure class="founder__fig" data-reveal>
      <div class="founder__mask">
        <img src={image} alt={`${copy.name}, ${copy.role} of BIZ & STYLE`} width="1024" height="1024" loading="lazy" decoding="async" />
      </div>
    </figure>
    <div class="founder__text">
      <p class="eyebrow eyebrow--marker" data-reveal>{copy.eyebrow}</p>
      <p class="founder__who" data-reveal>
        <span class="founder__name display-3">{copy.name}</span>
        <span class="eyebrow">{copy.role}</span>
      </p>
      <h2 id="founder-title" class="editorial founder__title" data-reveal>{copy.title}</h2>
      <div class="prose founder__body" data-reveal>
        {copy.body.map((p) => <p>{p}</p>)}
      </div>
      <ul class="founder__facts small" role="list" data-reveal-group>
        {copy.facts.map((f) => <li>{f}</li>)}
      </ul>
      <a class="link" href={copy.cta.href} data-reveal data-track="navigation_click" data-track-cta-name="leadership">
        {copy.cta.label}
        <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .founder__grid {
    display: grid;
    gap: var(--space-8);
  }

  .founder__fig {
    display: grid;
    gap: var(--space-3);
  }

  .founder__mask {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 1.4s var(--ease-out);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 58%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 58%, transparent 100%);
  }
  .founder__mask::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, var(--onyx) 0%, transparent 22%, transparent 78%, var(--onyx) 100%),
      linear-gradient(180deg, rgba(8, 9, 11, 0.55) 0%, transparent 30%),
      radial-gradient(85% 75% at 50% 42%, transparent 55%, var(--onyx) 100%);
  }

  .is-in .founder__mask {
    clip-path: inset(0 0 0 0);
  }

  .founder__mask img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(0.95) brightness(0.88);
  }

  .founder__text {
    display: grid;
    gap: var(--space-5);
    align-content: center;
  }

  .founder__who {
    display: grid;
    gap: 0.3rem;
  }

  .founder__title {
    color: var(--paper);
  }

  .founder__body {
    color: var(--stone);
  }

  .founder__facts {
    display: grid;
    border-top: 1px solid var(--rule-deep);
  }

  .founder__facts li {
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--rule-deep);
    color: var(--stone);
  }

  @media (min-width: 900px) {
    .founder__grid {
      grid-template-columns: 5fr 7fr;
      column-gap: calc(var(--gutter) * 2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .founder__mask { clip-path: none; }
  }
</style>
