---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'insights'>;
  categoryName: string;
  readingTime: number;
  readingLabel?: string;
  tone?: 'paper' | 'onyx';
}
const { entry, categoryName, readingTime, readingLabel = 'min read', tone = 'paper' } = Astro.props;
const { title, excerpt, publishDate, hero } = entry.data;
const href = `/insights/${entry.id.split('/').pop()}`;
const date = publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<article class="card">
  <a href={href} class="card__link" data-track="article_view" data-track-article-category={entry.data.category.id}>
    <div class="card__media">
      {hero?.image ? <img src={hero.image.src} width={hero.image.width} height={hero.image.height} alt={hero.alt} loading="lazy" decoding="async" /> : (
        <div class="card__cover">
          <span class="card__cover-k">{categoryName}</span>
          <h3 class="card__cover-t">{title}</h3>
          <span class="card__cover-d">{date}</span>
        </div>
      )}
    </div>
    <div class="card__body">
      {hero?.image && <p class="eyebrow">{categoryName}</p>}
      {hero?.image && <h3 class="card__title">{title}</h3>}
      <p class="card__excerpt small muted">{excerpt}</p>
      <p class="num card__meta">
        <time datetime={publishDate.toISOString()}>{date}</time> · {readingTime} {readingLabel}
      </p>
    </div>
  </a>
</article>

<style>
  .card__cover {
    display: grid;
    align-content: space-between;
    gap: 1rem;
    aspect-ratio: 16 / 10;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: linear-gradient(160deg, rgba(24, 30, 38, 0.9), rgba(8, 9, 11, 0.95));
    color: var(--paper);
  }
  .card__cover-k {
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .card__cover-t {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 114, 'wght' 720;
    font-stretch: 114%;
    font-size: 1.15rem;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__cover-d {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .card__link {
    display: grid;
    gap: var(--space-4);
    height: 100%;
  }

  .card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--surface);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .card__link:hover .card__media img {
    transform: scale(1.04);
  }

  .card__body {
    display: grid;
    gap: var(--space-3);
  }

  .card__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100, 'wght' 600;
    font-stretch: 100%;
    font-size: 1.3rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .card__meta {
    margin-top: var(--space-2);
  }
</style>
