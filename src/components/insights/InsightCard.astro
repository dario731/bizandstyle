---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'insights'>;
  categoryName: string;
  readingTime: number;
  readingLabel?: string;
  tone?: 'paper' | 'onyx';
}
const { entry, categoryName, readingTime, readingLabel = 'min read', tone = 'paper' } = Astro.props;
const { title, excerpt, publishDate, hero } = entry.data;
const href = `/insights/${entry.id.split('/').pop()}`;
const date = publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<article class="card">
  <a href={href} class="card__link" data-track="article_view" data-track-article-category={entry.data.category.id}>
    <div class="card__media">
      {hero?.image ? <img src={hero.image.src} width={hero.image.width} height={hero.image.height} alt={hero.alt} loading="lazy" decoding="async" /> : (
        <div class="card__cover">
          <span class="card__cover-top"><span class="card__cover-k">{categoryName}</span><span class="card__cover-r">{readingTime} {readingLabel}</span></span>
          <h3 class="card__cover-t">{title}</h3>
          <span class="card__cover-foot"><span class="card__cover-d">{date}</span><span class="card__cover-go">Read<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></span></span>
        </div>
      )}
    </div>
    <div class="card__body">
      {hero?.image && <p class="eyebrow">{categoryName}</p>}
      {hero?.image && <h3 class="card__title">{title}</h3>}
      <p class="card__excerpt small muted">{excerpt}</p>
      {hero?.image && (
        <p class="num card__meta">
          <time datetime={publishDate.toISOString()}>{date}</time> · {readingTime} {readingLabel}
        </p>
      )}
    </div>
  </a>
</article>

<style>
  .card__cover {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: 1rem;
    min-height: 15rem;
    padding: 1.2rem 1.3rem 1.2rem 1.5rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--brass);
    border-radius: 2px;
    background:
      radial-gradient(70% 60% at 100% 0%, rgba(245, 247, 249, 0.14), transparent 60%),
      linear-gradient(160deg, rgba(27, 28, 31, 0.95), rgba(8, 9, 11, 0.98));
    color: #f5f7f9;
    --fg: #f5f7f9;
    --fg-muted: #9fa2a7;
    --stone: #9fa2a7;
    --brass: #f5f7f9;
    --line: rgba(245, 247, 249, 0.14);
    transition: border-color 0.3s, transform 0.4s var(--ease-out);
  }
  .card__link:hover .card__cover { transform: translateY(-3px); border-color: var(--brass); }
  .card__cover-top, .card__cover-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .card__cover-r, .card__cover-go {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .card__cover-go { display: inline-flex; align-items: center; gap: 0.4em; color: var(--paper); }
  .card__cover-go svg { width: 0.9em; height: 0.9em; }
  .card__cover-k {
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .card__cover-t {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 114, 'wght' 720;
    font-stretch: 114%;
    font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__cover-d {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .card__link {
    display: grid;
    gap: var(--space-4);
    height: 100%;
  }

  .card__media:has(.card__cover) { aspect-ratio: auto; }
  .card__cover { height: 100%; }
  .card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--surface);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .card__link:hover .card__media img {
    transform: scale(1.04);
  }

  .card__body {
    display: grid;
    gap: var(--space-3);
  }

  .card__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 100, 'wght' 600;
    font-stretch: 100%;
    font-size: 1.3rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .card__meta {
    margin-top: var(--space-2);
  }
</style>
