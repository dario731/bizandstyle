---
import { getCollection, getEntry } from 'astro:content';
import InsightCard from './InsightCard.astro';
import { readingTime } from '@lib/reading-time';
import type { Copy } from '@i18n/en';

interface Props {
  copy: Copy['home']['insights'];
  limit?: number;
}
const { copy, limit = 3 } = Astro.props;

const all = (await getCollection('insights', ({ data }) => !data.draft && data.locale === 'en')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const latest = all.slice(0, limit);
const cards = await Promise.all(
  latest.map(async (entry) => {
    const cat = await getEntry(entry.data.category);
    return { entry, categoryName: cat?.data.name ?? '', readingTime: readingTime(entry.body ?? '') };
  }),
);
const categories = (await getCollection('categories')).filter((c) => c.data.locale === 'en');
---

<section class="section ground-paper ins" id="insights" aria-labelledby="ins-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow--marker" data-reveal>{copy.eyebrow}</p>
      <h2 id="ins-title" class="display-2" data-reveal>{copy.title}</h2>
      <p class="lede" data-reveal>{copy.lede}</p>
    </div>

    <div class="ins__grid" data-reveal-group>
      {cards.map((c) => <InsightCard entry={c.entry} categoryName={c.categoryName} readingTime={c.readingTime} readingLabel={copy.readingTime} />)}
    </div>

    <div class="ins__foot" data-reveal>
      <ul class="ins__cats" role="list">
        {categories.slice(0, 8).map((c) => <li><a href={`/insights/category/${c.id}`}>{c.data.name}</a></li>)}
      </ul>
      <a class="btn" href={copy.cta.href} data-track="navigation_click" data-track-cta-name="all_insights">
        {copy.cta.label}
        <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .ins__grid {
    display: grid;
    gap: var(--space-7) var(--gutter);
  }

  .ins__foot {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .ins__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ins__cats a {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    padding: 0.45em 0.9em;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--smoke);
    transition: color var(--dur-1), border-color var(--dur-1);
  }

  .ins__cats a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  @media (min-width: 720px) {
    .ins__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ins__foot {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
