---
/**
 * GlobalMap — an abstract route map on a dot grid: Europe → Miami → the
 * Americas. Arcs draw on entry. Positions are schematic, not geographic
 * coordinates; the text beside it carries the facts.
 */
import type { Copy } from '@i18n/en';
interface Props {
  copy: Copy['home']['miami'];
}
const { copy } = Astro.props;

const W = 1000;
const H = 620;
const miami = { x: 430, y: 300 };
const europe = { x: 900, y: 120 };
const targets = [
  { name: copy.nodes.targets[0], x: 300, y: 130 },   // United States
  { name: copy.nodes.targets[1], x: 190, y: 330 },   // Mexico
  { name: copy.nodes.targets[2], x: 560, y: 380 },   // Caribbean
  { name: copy.nodes.targets[3], x: 700, y: 520 },   // Brazil
  { name: copy.nodes.targets[4], x: 420, y: 560 },   // LATAM
];
const arc = (a: { x: number; y: number }, b: { x: number; y: number }, lift = 0.22) => {
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const cx = mx - dy * lift;
  const cy = my + dx * lift;
  return `M${a.x} ${a.y} Q${cx} ${cy} ${b.x} ${b.y}`;
};
---

<section class="section ground-paper map" id="miami" aria-labelledby="map-title" data-map>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow--marker" data-reveal>{copy.eyebrow}</p>
      <h2 id="map-title" class="display-2" data-reveal>
        <span>{copy.title[0]}</span>
        <span class="muted">{copy.title[1]}</span>
      </h2>
    </div>

    <div class="map__stage">
      <div class="map__vis" data-reveal>
        <svg class="map__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-svg-title">
          <title id="map-svg-title">Routes from Europe through Miami to the United States, Mexico, the Caribbean, Brazil and Latin America</title>
          <defs>
            <pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse">
              <circle cx="1" cy="1" r="1" fill="currentColor" fill-opacity="0.16" />
            </pattern>
          </defs>
          <rect width={W} height={H} fill="url(#dots)" />
          <path class="map__arc map__arc--in" d={arc(europe, miami, -0.25)} fill="none" stroke="var(--brass)" stroke-width="1.5" pathLength="100" />
          {targets.map((t, i) => <path class="map__arc" style={`--i:${i}`} d={arc(miami, t, i % 2 ? 0.18 : -0.18)} fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 4" pathLength="100" />)}
          <g class="map__node">
            <circle cx={europe.x} cy={europe.y} r="6" fill="currentColor" />
            <text x={europe.x - 14} y={europe.y + 5} text-anchor="end">{copy.nodes.origin}</text>
          </g>
          {
            targets.map((t) => (
              <g class="map__node">
                <circle cx={t.x} cy={t.y} r="5" fill="var(--paper)" stroke="currentColor" stroke-width="1.5" />
                <text x={t.x + 14} y={t.y + 5}>{t.name}</text>
              </g>
            ))
          }
          <g class="map__hub">
            <circle class="map__hub-ring" cx={miami.x} cy={miami.y} r="26" fill="none" stroke="var(--brass)" />
            <circle cx={miami.x} cy={miami.y} r="9" fill="var(--brass)" />
            <text class="map__hub-label" x={miami.x} y={miami.y - 40} text-anchor="middle">{copy.nodes.hub}</text>
          </g>
        </svg>
      </div>

      <div class="map__side">
        <p class="display-3 map__triplet" data-reveal>{copy.triplet.map((l) => <span>{l}</span>)}</p>
        <p class="prose small muted" data-reveal>{copy.body}</p>
        <dl class="map__presence" data-reveal-group>
          {copy.presence.map((p) => (
            <div>
              <dt>{p.k}</dt>
              <dd class="small muted">{p.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <dl class="map__facts" data-reveal-group>
      {
        copy.facts.map((f) => (
          <div class="fact">
            <dt class="eyebrow">{f.k}</dt>
            <dd class="small">{f.v}</dd>
          </div>
        ))
      }
    </dl>

    <div class="map__foot" data-reveal>
      <a class="link" href={copy.cta.href} data-track="navigation_click" data-track-cta-name="why_miami">
        {copy.cta.label}
        <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  #map-title span {
    display: block;
  }

  .map__stage {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .map__vis {
    color: var(--ink);
    border: 1px solid var(--line);
    background: var(--ivory);
  }

  .map__svg {
    width: 100%;
    height: auto;
    font-family: var(--font-body);
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .map__svg text {
    fill: var(--ink);
  }

  .map__hub-label {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .map__arc {
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 1.8s var(--ease-out);
    transition-delay: calc(1.2s + var(--i, 0) * 180ms);
  }

  .map__arc--in {
    transition-delay: 0.2s;
  }

  .is-in .map__arc {
    stroke-dashoffset: 0;
  }

  .map__hub-ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: hub-pulse 3.6s var(--ease-in-out) infinite;
    animation-play-state: paused;
  }

  .is-active .map__hub-ring {
    animation-play-state: running;
  }

  @keyframes hub-pulse {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  .map__side {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }

  .map__triplet span {
    display: block;
  }

  .map__triplet span:nth-child(2) {
    color: var(--smoke);
  }

  .map__presence {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .map__presence > div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-4);
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  .map__presence dt {
    font-weight: 500;
  }

  .map__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-6);
    margin-top: var(--space-9);
    padding-top: var(--space-7);
    border-top: 1px solid var(--line);
  }

  .fact {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .fact dd {
    color: var(--smoke);
    max-width: 30ch;
  }

  .map__foot {
    margin-top: var(--space-7);
  }

  @media (min-width: 900px) {
    .map__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .map__stage {
      grid-template-columns: 7fr 5fr;
      column-gap: calc(var(--gutter) * 2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map__arc { stroke-dashoffset: 0; }
    .map__hub-ring { animation: none; transform: scale(1); }
  }
</style>

<script>
  import { whileInView } from '@lib/reveal';
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((root) => {
    const vis = root.querySelector<HTMLElement>('.map__vis');
    if (vis) whileInView(vis, 'is-in', 0.3);
    whileInView(root, 'is-active', 0.2);
  });
</script>
