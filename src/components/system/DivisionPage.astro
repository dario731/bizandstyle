---
/**
 * DivisionPage — hub for Advisory / Commerce / Luxury. Hero, definition,
 * service grid (linked), a signature module slot, statement, insights, CTA.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/editorial/EditorialHero.astro';
import Definition from '@components/editorial/Definition.astro';
import ModuleGrid from '@components/editorial/ModuleGrid.astro';
import Statement from '@components/editorial/Statement.astro';
import FaqBlock from '@components/editorial/FaqBlock.astro';
import ContextualCta from '@components/conversion/ContextualCta.astro';
import RelatedInsights from '@components/insights/RelatedInsights.astro';
import { byDivision, divisionMeta, servicePath, type Division } from '@data/services';
import { breadcrumbLd, faqLd, serviceLd, webPageLd, graph } from '@lib/seo';

interface Props {
  division: Division;
  seo: { title: string; description: string };
  hero: { eyebrow: string; title: readonly string[]; lede: string; mediaId: string };
  definition: { q: string; a: readonly string[] };
  statement: { lines: readonly string[]; body?: readonly string[]; editorial?: string };
  faqs: readonly { q: string; a: string }[];
  cta: { eyebrow: string; title: readonly string[]; primary: { label: string; href: string; name: string }; secondary?: { label: string; href: string; name: string } };
  servicesTitle?: string;
  extraCapabilities?: readonly { name: string; line: string; href: string }[];
  relatedLinks?: readonly { href: string; label: string; line?: string }[];
  insightsCluster?: readonly string[];
  schema?: {
    pageType?: string | readonly string[];
    serviceName?: string;
    serviceType?: string;
    areaServed?: readonly string[];
    breadcrumbName?: string;
  };
}
const { division, seo, hero, definition, statement, faqs, cta, servicesTitle = 'Capabilities', extraCapabilities = [], relatedLinks, insightsCluster = [], schema = {} } = Astro.props;
const div = divisionMeta[division];
const list = byDivision(division);
const crumbName = schema.breadcrumbName ?? div.name;
const capabilityItems = [
  ...list.map((s) => ({ name: s.title, line: s.lede, href: servicePath(s) })),
  ...extraCapabilities,
];
const jsonLd = graph(
  webPageLd({ name: seo.title, description: seo.description, path: div.path, type: schema.pageType ?? 'CollectionPage' }),
  serviceLd({
    name: schema.serviceName ?? div.name,
    description: definition.a[0],
    path: div.path,
    serviceType: schema.serviceType ?? div.role,
    areaServed: schema.areaServed,
  }),
  breadcrumbLd([{ name: crumbName, path: div.path }]),
  faqLd([...faqs], `https://bizandstyledna.com${div.path}#faq`),
);
---

<BaseLayout title={seo.title} description={seo.description} path={div.path} pageType="division" {jsonLd}>
  <EditorialHero eyebrow={hero.eyebrow} title={hero.title} lede={hero.lede} ground={div.ground} mediaId={hero.mediaId} mediaAlt={div.name} crumbs={[{ name: crumbName, path: div.path }]} brief={`What ${div.name} does, the ${list.length} services inside it, how they are delivered, and how to start.`}>
    <a class="btn btn--solid" href={cta.primary.href} data-track="cta_click" data-track-cta-name={cta.primary.name} data-track-cta-location="division_hero" data-track-division={division}>
      <span class="btn__ring" aria-hidden="true"></span>{cta.primary.label}
    </a>
  </EditorialHero>
  <slot name="after-hero" />
  <ModuleGrid eyebrow={div.role} title={servicesTitle} items={capabilityItems} columns={capabilityItems.length >= 8 ? 4 : capabilityItems.length >= 6 ? 3 : 3} ground="onyx" id="services" trackAs="service_view" />
  <Definition question={definition.q} answer={definition.a} ground="paper" id="definition" />
  <slot name="before-services" />
  <slot name="after-services" />
  <Statement lines={statement.lines} body={statement.body} editorial={statement.editorial} ground="onyx" eyebrow={div.name} />
  {
    relatedLinks && relatedLinks.length > 0 && (
      <ModuleGrid eyebrow="Continue" title="Related on the platform." items={relatedLinks.map((l) => ({ name: l.label, line: l.line, href: l.href }))} columns={relatedLinks.length >= 4 ? 4 : 3} ground="paper" numbered={false} trackAs="navigation_click" />
    )
  }
  <RelatedInsights clusterOf={[div.path, ...list.map((s) => servicePath(s)), ...list.map((s) => `${div.path}/${s.slug}`), ...insightsCluster]} ground="paper" />
  <FaqBlock {faqs} title="FAQ" ground="paper" />
  <ContextualCta eyebrow={cta.eyebrow} title={cta.title} primary={cta.primary} secondary={cta.secondary} location="division_cta" />
</BaseLayout>
