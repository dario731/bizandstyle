---
/**
 * DivisionTransition — a full-bleed editorial band for one division. Media on
 * one side, statement + four capability lines on the other; bands alternate
 * ground and media side so the three read as one sequence.
 */
import CinematicMedia from '@components/cinematic/CinematicMedia.astro';
import type { Copy } from '@i18n/en';

interface Props {
  item: Copy['home']['divisions']['items'][number];
  index: number;
  eyebrow?: string;
}
const { item, index, eyebrow } = Astro.props;
const ground = item.ground === 'onyx' ? 'ground-onyx' : 'ground-paper';
const flip = index % 2 === 1;
const slug = item.cta.href.slice(1);
---

<section class:list={['div', ground, { 'div--flip': flip }]} id={`division-${slug}`} aria-labelledby={`div-title-${slug}`} data-division={slug}>
  <div class="div__media">
    <CinematicMedia manifestId={item.mediaId} alt={`${item.name} — ${item.statement}`} ratio="4 / 5" class="div__cm" tone={item.ground === 'onyx' ? 'onyx' : 'paper'} />
  </div>
  <div class="div__content">
    <div class="div__inner">
      {eyebrow && index === 0 && <p class="eyebrow eyebrow--marker" data-reveal>{eyebrow}</p>}
      <p class="num" data-reveal>{item.num}</p>
      <h2 id={`div-title-${slug}`} class="div__name" data-reveal>{item.name}</h2>
      <p class="display-2 div__statement" data-reveal>{item.statement}</p>
      <p class="prose div__body muted" data-reveal>{item.body}</p>
      <ul class="div__points" role="list" data-reveal-group>
        {item.points.map((p) => <li>{p}</li>)}
      </ul>
      <a class="btn" href={item.cta.href} data-reveal data-track="division_view" data-track-division={slug} data-track-cta-location="home_divisions">
        {item.cta.label}
        <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .div {
    display: grid;
    grid-template-columns: 1fr;
  }

  .div__media {
    position: relative;
    min-height: 60vw;
    overflow: hidden;
  }

  .div__media :global(.div__cm) {
    position: absolute;
    inset: 0;
    height: 100%;
    aspect-ratio: auto;
    border-radius: 0;
  }

  .div__content {
    display: grid;
    align-items: center;
    padding: var(--space-section-sm) var(--gutter);
  }

  .div__inner {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
  }

  .div__name {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .div__points {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .div__inner > .btn {
    justify-self: start;
  }

  .div__points li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }

  @media (min-width: 900px) {
    .div {
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }
    .div__media {
      min-height: 0;
      position: sticky;
      top: 0;
      height: 100vh;
    }
    .div--flip .div__media {
      order: 2;
    }
    .div__content {
      padding: var(--space-section) clamp(2rem, 6vw, 7rem);
    }
    .div__inner {
      margin-inline: auto;
    }
  }
</style>
