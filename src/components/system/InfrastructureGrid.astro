---
import type { Copy } from '@i18n/en';
interface Props {
  copy: Copy['home']['infrastructure'];
}
const { copy } = Astro.props;
---

<section class="section ground-paper infra" id="infrastructure" aria-labelledby="infra-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow--marker" data-reveal>{copy.eyebrow}</p>
      <h2 id="infra-title" class="display-2" data-reveal>
        <span>{copy.title[0]}</span>
        <span class="muted">{copy.title[1]}</span>
      </h2>
    </div>

    <ol class="infra__grid" role="list" data-reveal-group>
      {
        copy.modules.map((m, i) => (
          <li class:list={['module', { 'module--partners': i === copy.modules.length - 1 }]}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="module__name">{m.name}</h3>
            <p class="module__line small muted">{m.line}</p>
          </li>
        ))
      }
    </ol>

    <div class="infra__foot" data-reveal>
      <p class="small infra__note muted">{copy.note}</p>
      <a class="link" href={copy.cta.href} data-track="service_view" data-track-service="infrastructure">
        {copy.cta.label}
        <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  #infra-title span {
    display: block;
  }

  .infra__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .module {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    min-height: 14rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background var(--dur-2);
  }

  .module:hover {
    background: var(--ivory);
  }

  .module__name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 110, 'wght' 650;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .module--partners {
    background: var(--onyx);
    color: var(--paper);
    --fg-muted: var(--stone);
  }

  .module--partners:hover {
    background: var(--onyx);
  }

  .infra__foot {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
  }

  .infra__note {
    max-width: 72ch;
  }

  @media (min-width: 900px) {
    .infra__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .infra__foot {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
</style>
