---
/**
 * DigitalEngine — "From click to client". A vertical rail of nodes that light in
 * sequence while in view, with a drawn return arc that shows the loop back to
 * Intelligence. No library; one interval, paused off-screen.
 */
import type { Copy } from '@i18n/en';
interface Props {
  copy: Copy['home']['digital'];
}
const { copy } = Astro.props;
---

<section class="section ground-onyx de" id="digital-engine" aria-labelledby="de-title" data-engine>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow--marker" data-reveal>{copy.eyebrow}</p>
      <h2 id="de-title" class="display-2" data-reveal>{copy.title}</h2>
      <p class="lede" data-reveal>{copy.lede}</p>
    </div>

    <div class="de__grid">
      <div class="de__left">
        <p class="display-3 de__statement" data-reveal>{copy.statement}</p>
        <ul class="de__caps" role="list" data-reveal-group>
          {copy.capabilities.map((c) => <li>{c}</li>)}
        </ul>
        <div class="de__cta" data-reveal>
          <p class="eyebrow">{copy.ctaEyebrow}</p>
          <a class="btn" href={copy.cta.href} data-track="cta_click" data-track-cta-name="digital_growth_review" data-track-cta-location="home_digital">
            {copy.cta.label}
            <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
          </a>
        </div>
      </div>

      <div class="de__rail" data-reveal>
        <svg class="de__return" viewBox="0 0 60 1000" preserveAspectRatio="none" aria-hidden="true">
          <path class="de__return-path" d="M2 8 C 58 8, 58 8, 58 120 L 58 880 C 58 992, 58 992, 2 992" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 5" pathLength="100" />
          <path class="de__return-head" d="M10 985 L2 992 L10 999" fill="none" stroke="currentColor" stroke-width="1.2" />
        </svg>
        <ol class="de__nodes" role="list" aria-label="Acquisition system">
          {
            copy.nodes.map((n, i) => (
              <li class="de__node" data-node={i}>
                <span class="de__node-dot" aria-hidden="true"></span>
                <span class="num">{String(i + 1).padStart(2, '0')}</span>
                <span class="de__node-name">{n}</span>
              </li>
            ))
          }
          <li class="de__node de__node--loop" data-node={copy.nodes.length}>
            <span class="de__node-dot" aria-hidden="true"></span>
            <span class="num">∞</span>
            <span class="de__node-name">{copy.nodes[0]} <span class="muted">— {copy.loopLabel}</span></span>
          </li>
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .de__grid {
    display: grid;
    gap: var(--space-8);
  }

  .de__left {
    display: grid;
    gap: var(--space-7);
    align-content: start;
  }

  .de__statement {
    max-width: 22ch;
  }

  .de__caps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .de__caps li {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    padding: 0.45em 0.9em;
    border: 1px solid var(--rule-deep);
    border-radius: 999px;
    color: var(--stone);
  }

  .de__cta {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .de__rail {
    position: relative;
    padding-right: 2.5rem;
  }

  .de__return {
    position: absolute;
    right: 0;
    top: 0;
    width: 60px;
    height: 100%;
    color: var(--brass);
    overflow: visible;
  }

  .de__return-path {
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 3s var(--ease-out) 0.6s;
  }

  .is-in .de__return-path {
    stroke-dashoffset: 0;
  }

  .de__return-head {
    opacity: 0;
    transition: opacity var(--dur-2) 3.4s;
  }

  .is-in .de__return-head {
    opacity: 1;
  }

  .de__nodes {
    position: relative;
    display: grid;
    border-top: 1px solid var(--rule-deep);
  }

  .de__nodes::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule-deep);
  }

  .de__node {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem 2.5rem 1fr;
    align-items: center;
    gap: var(--space-3);
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule-deep);
    color: var(--stone);
    transition: color var(--dur-2);
  }

  .de__node-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1.5px solid var(--rule-deep);
    background: var(--onyx);
    transition: border-color var(--dur-2), background var(--dur-2), box-shadow var(--dur-2);
  }

  .de__node.is-lit {
    color: var(--paper);
  }

  .de__node.is-lit .de__node-dot {
    border-color: var(--brass);
    background: var(--brass);
    box-shadow: 0 0 0 4px var(--brass-soft);
  }

  .de__node-name {
    font-size: 0.95rem;
  }

  .de__node--loop {
    color: var(--stone);
  }

  @media (min-width: 1024px) {
    .de__grid {
      grid-template-columns: 6fr 6fr;
      column-gap: calc(var(--gutter) * 2);
    }
    .de__left {
      position: sticky;
      top: 7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .de__return-path { stroke-dashoffset: 0; }
    .de__return-head { opacity: 1; }
    .de__node { color: var(--paper); }
    .de__node .de__node-dot { border-color: var(--brass); background: var(--brass); box-shadow: none; }
  }
</style>

<script>
  import { whileInView, reducedMotion } from '@lib/reveal';
  document.querySelectorAll<HTMLElement>('[data-engine]').forEach((root) => {
    const nodes = Array.from(root.querySelectorAll<HTMLElement>('[data-node]'));
    const rail = root.querySelector<HTMLElement>('.de__rail');
    if (rail) whileInView(rail, 'is-in', 0.2);
    if (reducedMotion()) {
      nodes.forEach((n) => n.classList.add('is-lit'));
      return;
    }
    let i = -1;
    let timer = 0;
    const step = () => {
      i = (i + 1) % (nodes.length + 2);
      nodes.forEach((n, k) => n.classList.toggle('is-lit', k <= i));
      timer = window.setTimeout(step, i === nodes.length - 1 ? 1400 : i >= nodes.length ? 300 : 420);
    };
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (e.isIntersecting) {
            if (!timer) step();
          } else {
            window.clearTimeout(timer);
            timer = 0;
          }
        }),
      { threshold: 0.15 },
    );
    io.observe(root);
  });
</script>
