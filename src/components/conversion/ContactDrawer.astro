---
/**
 * ContactDrawer — one slide-in panel for every "connect" action on the site.
 * Tabs: Message (lead form → /api/lead), Book a call (Calendly embedded),
 * Call & WhatsApp. Opened by any element with data-open-contact="message|call|direct".
 */
import LeadFormLite from './LeadFormLite.astro';
import { site } from '@data/site';
const wa = `https://wa.me/${site.phoneHref.replace(/\D/g, '')}?text=${encodeURIComponent("Hi BIZ & STYLE — I'd like to talk about what I'm building.")}`;
const calendly = `${site.calendly}?hide_gdpr_banner=1&background_color=0e0d0b&text_color=faf6ef&primary_color=b8975a`;
---

<div class="cd" data-contact-drawer hidden>
  <div class="cd__backdrop" data-cd-close></div>
  <aside class="cd__panel ground-onyx" role="dialog" aria-modal="true" aria-labelledby="cd-title" tabindex="-1" data-cd-panel>
    <header class="cd__head">
      <div>
        <p class="eyebrow eyebrow--marker">Let's connect</p>
        <h2 id="cd-title" class="cd__title">Start a conversation.</h2>
      </div>
      <button class="cd__close" type="button" aria-label="Close" data-cd-close>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" /></svg>
      </button>
    </header>

    <div class="cd__tabs" role="tablist" aria-label="How would you like to connect?">
      <button class="cd__tab" role="tab" type="button" id="cd-tab-message" aria-selected="true" aria-controls="cd-panel-message" data-cd-tab="message">Message</button>
      <button class="cd__tab" role="tab" type="button" id="cd-tab-call" aria-selected="false" aria-controls="cd-panel-call" data-cd-tab="call">Book a call</button>
      <button class="cd__tab" role="tab" type="button" id="cd-tab-direct" aria-selected="false" aria-controls="cd-panel-direct" data-cd-tab="direct">Call · WhatsApp</button>
    </div>

    <div class="cd__body">
      <section class="cd__pane" role="tabpanel" id="cd-panel-message" aria-labelledby="cd-tab-message" data-cd-pane="message">
        <p class="small muted cd__lead">Tell us in a few lines what you are building. A member of the team replies personally.</p>
        <LeadFormLite
          formId="connect-drawer"
          persona="founder"
          intent="other"
          fields={[
            { name: 'name', label: 'Your name', required: true, autocomplete: 'name' },
            { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
            { name: 'company', label: 'Company (optional)', autocomplete: 'organization' },
            { name: 'phone', label: 'Phone / WhatsApp (optional)', type: 'tel', autocomplete: 'tel' },
            { name: 'message', label: "What are you building?", type: 'textarea', rows: 4, required: true },
          ]}
          submitLabel="Send"
          consentLabel="I agree to be contacted about my message and have read the privacy policy."
          successTitle="Received."
          successBody="Thank you. We will come back to you personally, usually within one business day."
          errorLabel="Something went wrong. Please try again, or use WhatsApp or email."
        />
        <p class="small muted">Prefer the full form? <a class="link" href="/tell-us">Tell us what you're building</a></p>
      </section>

      <section class="cd__pane" role="tabpanel" id="cd-panel-call" aria-labelledby="cd-tab-call" data-cd-pane="call" hidden>
        <p class="small muted cd__lead">Pick a 30-minute slot with the team in Miami.</p>
        <div class="cd__calendly">
          <iframe title="Book a call with BIZ & STYLE" data-src={calendly} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <p class="small muted">Not loading? <a class="link" href={site.calendly} rel="noopener" data-track="calendar_click" data-track-cta-location="drawer">Open Calendly</a></p>
      </section>

      <section class="cd__pane" role="tabpanel" id="cd-panel-direct" aria-labelledby="cd-tab-direct" data-cd-pane="direct" hidden>
        <ul class="cd__direct" role="list">
          <li>
            <a class="cd__direct-item" href={wa} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-cta-location="drawer">
              <span class="cd__direct-k">WhatsApp</span>
              <span class="cd__direct-v">{site.phone}</span>
              <span class="cd__direct-s">Usually the fastest reply</span>
            </a>
          </li>
          <li>
            <a class="cd__direct-item" href={site.phoneHref} data-track="phone_click" data-track-cta-location="drawer">
              <span class="cd__direct-k">Call</span>
              <span class="cd__direct-v">{site.phone}</span>
              <span class="cd__direct-s">Miami · Eastern time</span>
            </a>
          </li>
          <li>
            <a class="cd__direct-item" href={`mailto:${site.email}`} data-track="email_click" data-track-cta-location="drawer">
              <span class="cd__direct-k">Email</span>
              <span class="cd__direct-v">{site.email}</span>
              <span class="cd__direct-s">For documents and longer briefs</span>
            </a>
          </li>
        </ul>
        <address class="small muted cd__addr">
          {site.legalName} · {site.address.streetAddress}, {site.address.addressLocality}, {site.address.addressRegion} {site.address.postalCode}
        </address>
      </section>
    </div>
  </aside>
</div>

<style>
  .cd {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-header) + 5);
  }

  .cd__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(14, 13, 11, 0.6);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.35s;
  }

  .cd__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(100%, 34rem);
    display: grid;
    grid-template-rows: auto auto 1fr;
    background: #121110;
    border-left: 1px solid rgba(250, 246, 239, 0.1);
    box-shadow: -30px 0 80px rgba(0, 0, 0, 0.5);
    transform: translateX(100%);
    transition: transform 0.5s var(--ease-out);
    overflow: hidden;
  }

  .cd.is-open .cd__backdrop { opacity: 1; }
  .cd.is-open .cd__panel { transform: none; }

  .cd__head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-6) var(--space-4);
  }

  .cd__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 116, 'wght' 720;
    font-stretch: 116%;
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin-top: 0.4rem;
  }

  .cd__close {
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border: 1px solid rgba(250, 246, 239, 0.25);
    border-radius: 2px;
    color: var(--paper);
    flex: none;
  }

  .cd__close svg { width: 1rem; height: 1rem; }

  .cd__tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(250, 246, 239, 0.1);
    border-bottom: 1px solid rgba(250, 246, 239, 0.1);
  }

  .cd__tab {
    padding: 0.9rem 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--stone);
    border-bottom: 2px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }

  .cd__tab[aria-selected='true'] {
    color: var(--paper);
    border-bottom-color: var(--brass);
  }

  .cd__body {
    overflow: auto;
    padding: var(--space-5) var(--space-6) var(--space-8);
  }

  .cd__pane {
    display: grid;
    gap: var(--space-5);
  }

  .cd__calendly {
    height: min(70vh, 720px);
    border: 1px solid rgba(250, 246, 239, 0.1);
    border-radius: 2px;
    overflow: hidden;
    background: #0e0d0b;
  }

  .cd__calendly iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .cd__direct {
    display: grid;
    gap: 0.6rem;
  }

  .cd__direct-item {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(250, 246, 239, 0.14);
    border-radius: 2px;
    transition: border-color 0.2s, background 0.2s;
  }

  .cd__direct-item:hover {
    border-color: var(--brass);
    background: rgba(184, 151, 90, 0.08);
  }

  .cd__direct-k {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .cd__direct-v {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 108, 'wght' 620;
    font-size: 1.15rem;
  }

  .cd__direct-s {
    font-size: 0.82rem;
    color: var(--stone);
  }

  .cd__addr {
    font-style: normal;
  }

  @media (prefers-reduced-motion: reduce) {
    .cd__panel, .cd__backdrop { transition: none; }
  }
</style>

<script>
  import { track } from '@lib/track';
  const drawer = document.querySelector<HTMLElement>('[data-contact-drawer]');
  if (drawer) {
    const panel = drawer.querySelector<HTMLElement>('[data-cd-panel]')!;
    const tabs = Array.from(drawer.querySelectorAll<HTMLButtonElement>('[data-cd-tab]'));
    const panes = Array.from(drawer.querySelectorAll<HTMLElement>('[data-cd-pane]'));
    let lastFocus: HTMLElement | null = null;

    const select = (name: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.cdTab === name)));
      panes.forEach((p) => (p.hidden = p.dataset.cdPane !== name));
      if (name === 'call') {
        const f = drawer.querySelector<HTMLIFrameElement>('[data-cd-pane="call"] iframe');
        if (f && !f.src) f.src = f.dataset.src!;
      }
    };
    const open = (name = 'message') => {
      lastFocus = document.activeElement as HTMLElement;
      drawer.hidden = false;
      requestAnimationFrame(() => drawer.classList.add('is-open'));
      select(name);
      document.documentElement.style.overflow = 'hidden';
      setTimeout(() => panel.focus(), 60);
      track('contact_drawer_open', { cta_name: name });
    };
    const close = () => {
      drawer.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      setTimeout(() => { drawer.hidden = true; lastFocus?.focus(); }, 450);
    };

    tabs.forEach((t) => t.addEventListener('click', () => select(t.dataset.cdTab!)));
    drawer.querySelectorAll('[data-cd-close]').forEach((c) => c.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !drawer.hidden) close(); });
    document.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('[data-open-contact], a[href="#connect"], a[href$="#connect"]');
      if (t) { e.preventDefault(); open(t.dataset.openContact || (t.getAttribute('href')?.endsWith('#connect') ? 'message' : 'message')); }
    });
    if (location.hash === '#connect') open('message');
  }
</script>
