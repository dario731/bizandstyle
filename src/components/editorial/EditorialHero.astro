---
/**
 * EditorialHero — the opening of every inner page. Eyebrow, large title,
 * lede and an optional media slot (manifest-aware). Ground is configurable so
 * divisions and landing pages can open on Onyx while hub pages open on Paper.
 */

interface Props {
  eyebrow?: string;
  title: string | readonly string[];
  lede?: string;
  ground?: 'onyx' | 'paper';
  mediaId?: string;
  mediaAlt?: string;
  visual?: 'rings' | 'orbit' | 'flow' | 'grid';
  crumbs?: { name: string; path: string }[];
  size?: 'display' | 'display-2';
  /** One plain sentence: what this page is for */
  brief?: string;
  /** Render the auto "On this page" strip (default true) */
  toc?: boolean;
  /** Short hero: the page's first visual sits right under the title */
  tight?: boolean;
}
const { eyebrow, title, lede, ground = 'onyx', mediaId, mediaAlt = '', crumbs = [], size = 'display', visual = 'orbit', brief, toc = true, tight = false } = Astro.props;
const lines = Array.isArray(title) ? title : [title];
const groundClass = ground === 'onyx' ? 'ground-onyx' : 'ground-paper';
---

<section class:list={['eh', groundClass, { 'eh--media': Boolean(mediaId), 'eh--tight': tight }]}>
  <div class="container eh__inner">
    <div class="eh__text">
      {eyebrow && <p class="eyebrow eyebrow--marker" data-reveal>{eyebrow}</p>}
      <h1 class:list={[size, 'eh__title']} data-reveal>
        {lines.map((l, i) => <span class:list={{ thin: i > 0 && lines.length > 1 }}>{l}</span>)}
      </h1>
      {lede && <p class="lede eh__lede" data-reveal>{lede}</p>}
      <div class="eh__slot" data-reveal><slot /></div>
    </div>
  </div>
</section>

<style>
  .eh {
    padding-top: clamp(5.5rem, 9vh, 7rem);
    padding-bottom: var(--space-6);
  }

  .eh__inner {
    display: grid;
    gap: var(--space-5);
  }
  .eh--tight { padding-bottom: var(--space-6); }
  .eh--tight .eh__inner { gap: var(--space-5); }
  .eh--tight .eh__text { gap: var(--space-4); }

  .eh__text {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }

  .eh__title span {
    display: block;
  }

  .eh__lede {
    color: var(--fg-muted);
  }

  .eh__brief {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    align-items: baseline;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--brass);
    font-size: 0.92rem;
    max-width: 44rem;
  }

  .eh__brief-k {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .eh__toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    align-items: center;
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eh__toc-k {
    color: var(--fg-muted);
  }

  .eh__toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
  }

  .eh__toc a {
    padding: 0.2rem 0;
    border-bottom: 1px solid transparent;
  }

  .eh__toc a:hover {
    border-bottom-color: currentColor;
  }

  @media (max-width: 720px) {
    .eh__toc { display: none; }
    .eh__lede { display: none; }
    .eh { padding-bottom: var(--space-6); }
    .eh { padding-top: 6rem; }
    .eh__media { display: none; }
  }

  .eh__slot:empty {
    display: none;
  }

  @media (min-width: 1024px) {
    .eh--media .eh__title {
      font-size: clamp(2rem, 3.9vw, 3.8rem);
    }
    .eh--media .eh__inner {
      grid-template-columns: 8fr 4fr;
      column-gap: calc(var(--gutter) * 2);
      align-items: center;
    }
    .eh--media :global(.crumbs) {
      grid-column: 1 / -1;
    }
  }
</style>

