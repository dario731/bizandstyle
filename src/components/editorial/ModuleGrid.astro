---
/**
 * ModuleGrid — now a swipeable card row (the carousel logic used across the
 * site). Numbered cards, arrows, drag, snap. Items may link.
 */
interface Item {
  name: string;
  line?: string;
  href?: string;
  tag?: string;
}
interface Props {
  eyebrow?: string;
  title?: string | readonly string[];
  lede?: string;
  items: readonly Item[];
  columns?: 2 | 3 | 4;
  ground?: 'onyx' | 'paper';
  id?: string;
  numbered?: boolean;
  trackAs?: string;
}
const { eyebrow, title, lede, items, ground = 'paper', id, numbered = true, trackAs } = Astro.props;
const lines = title ? (Array.isArray(title) ? title : [title]) : [];
---

<section class:list={['section mg', ground === 'onyx' ? 'ground-onyx' : 'ground-paper']} {id} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="container">
    <div class="mg__head">
      <div class="mg__headtext">
        {eyebrow && <p class="eyebrow eyebrow--marker" data-reveal>{eyebrow}</p>}
        {
          lines.length > 0 && (
            <h2 id={id ? `${id}-title` : undefined} class="display-2" data-reveal>
              {lines.map((l, i) => <span class:list={['mg__line', { muted: i > 0 }]}>{l}</span>)}
            </h2>
          )
        }
        {lede && <p class="lede" data-reveal>{lede}</p>}
      </div>
      <div class="snaprow__nav mg__nav" data-reveal>
        <span class="snaprow__hint">{items.length} · swipe</span>
        <button class="snaprow__btn" type="button" data-snap-prev aria-label="Previous"><svg viewBox="0 0 16 16"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
        <button class="snaprow__btn" type="button" data-snap-next aria-label="Next"><svg viewBox="0 0 16 16"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
      </div>
    </div>
    <div class="snaprow" data-snaprow data-reveal>
      <ol class="snaprow__track mg__track" role="list">
        {
          items.map((m, i) => {
            const inner = (
              <>
                <span class="snapcard__top">
                  {numbered ? <span class="num">{String(i + 1).padStart(2, '0')}</span> : <span />}
                  {m.tag && <span class="snapcard__tag">{m.tag}</span>}
                </span>
                <span class="snapcard__name">{m.name}</span>
                {m.line && <span class="snapcard__line">{m.line}</span>}
                {m.href && (
                  <svg class="snapcard__arrow" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                )}
              </>
            );
            return (
              <li>
                {m.href ? (
                  <a class="snapcard" href={m.href} data-track={trackAs} data-track-service={m.href.split('/').pop()}>
                    {inner}
                  </a>
                ) : (
                  <div class="snapcard">{inner}</div>
                )}
              </li>
            );
          })
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .mg__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .mg__headtext {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
  }

  .mg__line {
    display: block;
  }

  .mg__nav {
    flex: none;
  }

  .mg__track > li {
    display: grid;
  }

  .mg__track .snapcard {
    height: 100%;
    padding-bottom: 2.2rem;
  }

  @media (max-width: 720px) {
    .mg__head { flex-direction: column; align-items: start; }
  }
</style>
