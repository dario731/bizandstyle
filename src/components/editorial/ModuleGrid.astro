---
/**
 * ModuleGrid — now a swipeable card row (the carousel logic used across the
 * site). Numbered cards, arrows, drag, snap. Items may link.
 */
import Flow from '@components/cinematic/Flow.astro';
interface Item {
  name: string;
  line?: string;
  href?: string;
  tag?: string;
}
interface Props {
  eyebrow?: string;
  title?: string | readonly string[];
  lede?: string;
  items: readonly Item[];
  columns?: 2 | 3 | 4;
  ground?: 'onyx' | 'paper';
  id?: string;
  numbered?: boolean;
  trackAs?: string;
}
const { eyebrow, title, lede, items, ground = 'paper', id, numbered = true, trackAs } = Astro.props;
const lines = title ? (Array.isArray(title) ? title : [title]) : [];
---

<section class:list={['section mg', ground === 'onyx' ? 'ground-onyx' : 'ground-paper']} {id} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="container">
    <div class="mg__head">
      <div class="mg__headtext">
        {eyebrow && <p class="eyebrow eyebrow--marker" data-reveal>{eyebrow}</p>}
        {
          lines.length > 0 && (
            <h2 id={id ? `${id}-title` : undefined} class="display-2" data-reveal>
              {lines.map((l, i) => <span class:list={['mg__line', { muted: i > 0 }]}>{l}</span>)}
            </h2>
          )
        }
        {lede && <p class="lede" data-reveal>{lede}</p>}
      </div>
    </div>
    <div data-reveal>
      <Flow items={items.map((m) => ({ name: m.name, line: m.line, href: m.href, tag: m.tag }))} numbered={numbered} trackAs={trackAs} />
    </div>
  </div>
</section>

<style>
  .mg__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .mg__headtext {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
  }

  .mg__line {
    display: block;
  }

</style>
