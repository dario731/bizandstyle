---
/**
 * ModuleGrid — numbered capability modules on hairline grid. Used for services,
 * pillars, mistakes, infrastructure. Items may link.
 */
interface Item {
  name: string;
  line?: string;
  href?: string;
  tag?: string;
}
interface Props {
  eyebrow?: string;
  title?: string | readonly string[];
  lede?: string;
  items: readonly Item[];
  columns?: 2 | 3 | 4;
  ground?: 'onyx' | 'paper';
  id?: string;
  numbered?: boolean;
  trackAs?: string;
}
const { eyebrow, title, lede, items, columns = 4, ground = 'paper', id, numbered = true, trackAs } = Astro.props;
const lines = title ? (Array.isArray(title) ? title : [title]) : [];
---

<section class:list={['section mg', ground === 'onyx' ? 'ground-onyx' : 'ground-paper']} {id} aria-labelledby={id ? `${id}-title` : undefined}>
  <div class="container">
    {
      (eyebrow || lines.length > 0 || lede) && (
        <div class="section-head">
          {eyebrow && <p class="eyebrow eyebrow--marker" data-reveal>{eyebrow}</p>}
          {lines.length > 0 && (
            <h2 id={id ? `${id}-title` : undefined} class="display-2" data-reveal>
              {lines.map((l, i) => <span class:list={['mg__line', { muted: i > 0 }]}>{l}</span>)}
            </h2>
          )}
          {lede && <p class="lede" data-reveal>{lede}</p>}
        </div>
      )
    }
    <ol class="mg__grid" style={`--cols:${columns}`} role="list" data-reveal-group>
      {
        items.map((m, i) => {
          const inner = (
            <>
              <span class="mg__top">
                {numbered && <span class="num">{String(i + 1).padStart(2, '0')}</span>}
                {m.tag && <span class="mg__tag">{m.tag}</span>}
              </span>
              <span class="mg__name">{m.name}</span>
              {m.line && <span class="mg__desc small muted">{m.line}</span>}
              {m.href && (
                <svg class="mg__arrow" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              )}
            </>
          );
          return (
            <li class="mg__item">
              {m.href ? (
                <a class="mg__cell mg__cell--link" href={m.href} data-track={trackAs} data-track-service={m.href.split('/').pop()}>
                  {inner}
                </a>
              ) : (
                <div class="mg__cell">{inner}</div>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .mg__line {
    display: block;
  }

  .mg__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .mg__cell {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    height: 100%;
    min-height: 12rem;
    padding: clamp(1.1rem, 2.2vw, 1.8rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background var(--dur-2);
  }

  .mg__cell--link:hover {
    background: var(--surface);
  }

  .mg__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .mg__tag {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .mg__name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 110, 'wght' 650;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.15;
  }

  .mg__desc {
    max-width: 34ch;
  }

  .mg__arrow {
    position: absolute;
    right: 1.1rem;
    bottom: 1.1rem;
    width: 1rem;
    height: 1rem;
    opacity: 0.4;
    transition: opacity var(--dur-1), transform var(--dur-2) var(--ease-out);
  }

  .mg__cell--link:hover .mg__arrow {
    opacity: 1;
    transform: translateX(4px);
  }

  @media (min-width: 900px) {
    .mg__grid {
      grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    }
  }
</style>
