---
interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb" data-reveal>
  <ol role="list">
    <li><a href="/">Home</a></li>
    {
      items.map((it, i) => (
        <li>
          {i === items.length - 1 ? <span aria-current="page">{it.name}</span> : <a href={it.path}>{it.name}</a>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    opacity: 0.5;
  }

  .crumbs a:hover {
    color: var(--fg);
  }

  .crumbs [aria-current] {
    color: var(--fg);
  }
</style>
