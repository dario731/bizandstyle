---
/**
 * WorldMapCanvas — the dotted world map: Europe flows into Miami, Miami flows
 * to the Americas, Dubai and Singapore. Fills its positioned parent. Used in
 * the home hero and in the Miami section.
 */
interface Props {
  class?: string;
  labels?: boolean;
  opacity?: number;
}
const { class: cls, labels = true, opacity = 1 } = Astro.props;
---

<div class:list={['wmc', cls]} style={`opacity:${opacity}`} data-worldmap data-labels={labels ? 'true' : 'false'} aria-hidden="true">
  <canvas class="wmc__canvas"></canvas>
  <div class="wmc__labels"></div>
</div>

<style>
  .wmc {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .wmc__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .wmc__labels :global(span) {
    position: absolute;
    transform: translate(-50%, 8px);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(244, 246, 248, 0.7);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .wmc__labels :global(span.is-on) { opacity: 1; }

  .wmc__labels :global(span.is-hub) {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118, 'wght' 760;
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    color: var(--paper);
    transform: translate(-50%, -30px);
  }

  @media (max-width: 720px) {
    .wmc__labels :global(span.is-minor) { display: none; }
    .wmc__labels :global(span) { font-size: 0.52rem; letter-spacing: 0.14em; }
  }
</style>

<script>
  import dots from '@data/world-dots.json';
  import { gsap, reduced } from '@lib/motion';

  document.querySelectorAll<HTMLElement>('[data-worldmap]').forEach((wrap) => {
    const canvas = wrap.querySelector<HTMLCanvasElement>('canvas')!;
    const labels = wrap.querySelector<HTMLElement>('.wmc__labels')!;
    const showLabels = wrap.dataset.labels !== 'false';
    const ctx = canvas.getContext('2d')!;

    type City = { id: string; name: string; lon: number; lat: number; hub?: boolean; minor?: boolean };
    const MIAMI: City = { id: 'mia', name: 'Miami', lon: -80.19, lat: 25.76, hub: true };
    const europe: City[] = [
      { id: 'mil', name: 'Milan', lon: 9.19, lat: 45.46 },
      { id: 'lon', name: 'London', lon: -0.13, lat: 51.5, minor: true },
      { id: 'mad', name: 'Madrid', lon: -3.7, lat: 40.4 },
      { id: 'par', name: 'Paris', lon: 2.35, lat: 48.86, minor: true },
    ];
    const global: City[] = [
      { id: 'dxb', name: 'Dubai', lon: 55.27, lat: 25.2 },
      { id: 'sin', name: 'Singapore', lon: 103.82, lat: 1.35 },
    ];
    const americas: City[] = [
      { id: 'nyc', name: 'New York', lon: -74.0, lat: 40.71 },
      { id: 'tor', name: 'Toronto', lon: -79.38, lat: 43.65, minor: true },
      { id: 'lax', name: 'Los Angeles', lon: -118.24, lat: 34.05, minor: true },
      { id: 'mex', name: 'Mexico City', lon: -99.13, lat: 19.43 },
      { id: 'sdq', name: 'Santo Domingo', lon: -69.93, lat: 18.47, minor: true },
      { id: 'pty', name: 'Panama', lon: -79.52, lat: 8.98, minor: true },
      { id: 'bog', name: 'Bogotá', lon: -74.07, lat: 4.71 },
      { id: 'lim', name: 'Lima', lon: -77.04, lat: -12.05, minor: true },
      { id: 'sao', name: 'São Paulo', lon: -46.63, lat: -23.55 },
      { id: 'scl', name: 'Santiago', lon: -70.65, lat: -33.45, minor: true },
      { id: 'bue', name: 'Buenos Aires', lon: -58.38, lat: -34.6, minor: true },
    ];
    type Arc = { from: City; to: City; progress: number; delay: number; particles: number[] };
    const arcs: Arc[] = [
      ...europe.map((c, i) => ({ from: c, to: MIAMI, progress: 0, delay: i * 0.35, particles: [Math.random()] })),
      ...americas.map((c, i) => ({ from: MIAMI, to: c, progress: 0, delay: 1.8 + i * 0.22, particles: [Math.random(), Math.random()] })),
      ...global.map((c, i) => ({ from: MIAMI, to: c, progress: 0, delay: 4.4 + i * 0.5, particles: [Math.random()] })),
    ];

    let W = 0, H = 0;
    let view = { lon0: -132, lon1: 114, latC: 14, scale: 1 };
    const project = (lon: number, lat: number): [number, number] => [(lon - view.lon0) * view.scale, H / 2 - (lat - view.latC) * view.scale * 1.12];

    const labelEls = new Map<string, HTMLSpanElement>();
    const placeLabels = () => {
      if (!showLabels) return;
      for (const c of [MIAMI, ...europe, ...americas, ...global]) {
        let el = labelEls.get(c.id);
        if (!el) {
          el = document.createElement('span');
          el.textContent = c.name;
          if (c.hub) el.classList.add('is-hub', 'is-on');
          if (c.minor) el.classList.add('is-minor');
          labels.appendChild(el);
          labelEls.set(c.id, el);
        }
        const [x, y] = project(c.lon, c.lat);
        el.style.left = `${x}px`;
        el.style.top = `${y}px`;
      }
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = wrap.getBoundingClientRect();
      W = Math.round(r.width); H = Math.round(r.height);
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // fit: the lon range fills the width; if that makes the map shorter than the box, scale by height instead
      const lon0 = W < 720 ? -125 : -132, lon1 = W < 720 ? 112 : 114;
      const byWidth = W / (lon1 - lon0);
      const byHeight = H / (150 * 1.12);
      view = { lon0, lon1, latC: 14, scale: Math.max(byWidth, byHeight * 0.9) };
      // centre horizontally when scaled by height
      const mapW = (lon1 - lon0) * view.scale;
      view.lon0 = lon0 - (W - mapW) / 2 / view.scale;
      view.lon1 = view.lon0 + W / view.scale;
      placeLabels();
    };
    resize();
    new ResizeObserver(() => resize()).observe(wrap);

    let started = false;
    let t0 = 0;
    const start = () => {
      if (started) return;
      started = true;
      t0 = performance.now();
      arcs.forEach((a) => gsap.to(a, { progress: 1, duration: reduced() ? 0 : 1.6, delay: reduced() ? 0 : a.delay, ease: 'power2.inOut', onComplete: () => labelEls.get(a.to === MIAMI ? a.from.id : a.to.id)?.classList.add('is-on') }));
    };

    let running = false;
    new IntersectionObserver((es) => { running = es[0].isIntersecting; if (running) { start(); requestAnimationFrame(frame); } }, { threshold: 0.1 }).observe(wrap);

    const ctrl = (a: [number, number], b: [number, number]): [number, number] => {
      const mx = (a[0] + b[0]) / 2, my = (a[1] + b[1]) / 2;
      const dx = b[0] - a[0], dy = b[1] - a[1];
      const d = Math.hypot(dx, dy) || 1;
      const lift = Math.min(d * 0.28, 220);
      const nx = -dy / d, ny = dx / d;
      const sign = ny < 0 ? 1 : -1;
      return [mx + nx * lift * sign, my + ny * lift * sign];
    };
    const bez = (p0: [number, number], c: [number, number], p1: [number, number], t: number): [number, number] => {
      const u = 1 - t;
      return [u * u * p0[0] + 2 * u * t * c[0] + t * t * p1[0], u * u * p0[1] + 2 * u * t * c[1] + t * t * p1[1]];
    };

    function frame(now: number) {
      if (!running) return;
      const t = (now - t0) / 1000;
      const still = reduced();
      ctx.clearRect(0, 0, W, H);
      for (const [lon, lat] of dots as [number, number][]) {
        if (lon < view.lon0 - 2 || lon > view.lon1 + 2) continue;
        const [x, y] = project(lon, lat);
        if (y < -4 || y > H + 4) continue;
        const shimmer = still ? 0 : Math.sin(t * 0.8 + x * 0.02 + y * 0.03) * 0.05;
        ctx.fillStyle = `rgba(244,246,248,${0.2 + shimmer})`;
        ctx.beginPath(); ctx.arc(x, y, Math.max(0.9, view.scale * 0.19), 0, Math.PI * 2); ctx.fill();
      }
      for (const a of arcs) {
        if (a.progress <= 0) continue;
        const p0 = project(a.from.lon, a.from.lat);
        const p1 = project(a.to.lon, a.to.lat);
        const c = ctrl(p0, p1);
        const inbound = a.to === MIAMI;
        ctx.beginPath();
        ctx.moveTo(p0[0], p0[1]);
        for (let i = 1; i <= 48; i++) { const [x, y] = bez(p0, c, p1, (i / 48) * a.progress); ctx.lineTo(x, y); }
        const g = ctx.createLinearGradient(p0[0], p0[1], p1[0], p1[1]);
        g.addColorStop(0, inbound ? 'rgba(244,246,248,0.25)' : 'rgba(245,247,249,0.9)');
        g.addColorStop(1, inbound ? 'rgba(245,247,249,0.9)' : 'rgba(244,246,248,0.25)');
        ctx.strokeStyle = g; ctx.lineWidth = 1.1; ctx.stroke();
        const [ex, ey] = bez(p0, c, p1, a.progress);
        ctx.fillStyle = 'rgba(245,247,249,1)';
        ctx.beginPath(); ctx.arc(ex, ey, 2.2, 0, Math.PI * 2); ctx.fill();
        if (a.progress >= 1 && !still) {
          for (let k = 0; k < a.particles.length; k++) {
            a.particles[k] = (a.particles[k] + 0.0035 + k * 0.001) % 1;
            const [px, py] = bez(p0, c, p1, a.particles[k]);
            ctx.shadowBlur = 12; ctx.shadowColor = 'rgba(245,247,249,0.9)';
            ctx.fillStyle = 'rgba(244,246,248,0.95)';
            ctx.beginPath(); ctx.arc(px, py, 1.8, 0, Math.PI * 2); ctx.fill();
            ctx.shadowBlur = 0;
          }
        }
        const target = inbound ? p0 : p1;
        ctx.fillStyle = 'rgba(244,246,248,0.9)';
        ctx.beginPath(); ctx.arc(target[0], target[1], 2, 0, Math.PI * 2); ctx.fill();
      }
      const [mx, my] = project(MIAMI.lon, MIAMI.lat);
      for (let r = 0; r < 3; r++) {
        const ph = still ? 0.5 : (t * 0.5 + r / 3) % 1;
        ctx.strokeStyle = `rgba(245,247,249,${(1 - ph) * 0.6})`;
        ctx.lineWidth = 1;
        ctx.beginPath(); ctx.arc(mx, my, 6 + ph * 34, 0, Math.PI * 2); ctx.stroke();
      }
      ctx.fillStyle = '#f5f7f9';
      ctx.shadowBlur = 18; ctx.shadowColor = 'rgba(245,247,249,1)';
      ctx.beginPath(); ctx.arc(mx, my, 5, 0, Math.PI * 2); ctx.fill();
      ctx.shadowBlur = 0;
      requestAnimationFrame(frame);
    }
  });
</script>
