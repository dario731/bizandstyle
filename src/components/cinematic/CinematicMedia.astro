---
/**
 * CinematicMedia — video with poster, mobile derivative, reduced-motion and
 * save-data fallbacks. When no asset exists yet it renders a MediaPlaceholder
 * carrying the manifest ID, never a stock image.
 */
import MediaPlaceholder from './MediaPlaceholder.astro';

interface Props {
  manifestId: string;
  poster?: string;
  src?: string;
  srcMobile?: string;
  image?: string;
  alt: string;
  ratio?: string;
  class?: string;
  priority?: boolean;
  tone?: 'onyx' | 'paper';
}
const { manifestId, poster, src, srcMobile, image, alt, ratio = '16 / 9', class: cls = '', priority = false, tone = 'onyx' } = Astro.props;
const hasVideo = Boolean(src);
const hasImage = Boolean(image || poster);
---

<div class:list={['cm', cls]} style={`--ratio:${ratio}`} data-cinematic>
  {
    hasVideo ? (
      <video class="cm__video" playsinline muted loop autoplay preload={priority ? 'auto' : 'metadata'} poster={poster} aria-label={alt} data-src={src} data-src-mobile={srcMobile}>
        <source src={src} type="video/mp4" />
      </video>
    ) : hasImage ? (
      <img class="cm__img" src={image ?? poster} alt={alt} loading={priority ? 'eager' : 'lazy'} decoding="async" fetchpriority={priority ? 'high' : undefined} />
    ) : (
      <MediaPlaceholder id={manifestId} {alt} {tone} />
    )
  }
</div>

<style>
  .cm {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--onyx);
    border-radius: var(--radius-media);
  }

  .cm__video,
  .cm__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script>
  // Serve the 9:16 derivative on narrow screens; stop video under reduced-motion or save-data.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  document.querySelectorAll<HTMLVideoElement>('[data-cinematic] video').forEach((v) => {
    if (reduce || saveData) {
      v.removeAttribute('autoplay');
      v.pause();
      v.preload = 'none';
      return;
    }
    const mobile = v.dataset.srcMobile;
    if (mobile && window.innerWidth < 640) {
      const s = v.querySelector('source');
      if (s && s.src !== mobile) {
        s.src = mobile;
        v.load();
      }
    }
    const io = new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause())), { threshold: 0.1 });
    io.observe(v);
  });
</script>
