---
/**
 * MediaPlaceholder — a deliberate, art-directed frame for an asset that does
 * not exist yet. Shows the manifest ID so production can trace it. Fine
 * concentric rings echo the brand motif so the layout never reads as broken.
 */
interface Props {
  id: string;
  alt: string;
  tone?: 'onyx' | 'paper';
}
const { id, alt, tone = 'onyx' } = Astro.props;
---

<div class:list={['ph', `ph--${tone}`]} role="img" aria-label={`${alt} (asset pending)`}>
  <svg class="ph__rings" viewBox="0 0 800 450" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <radialGradient id={`g-${id}`} cx="50%" cy="50%" r="60%">
        <stop offset="0" stop-color="currentColor" stop-opacity="0.16" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0" />
      </radialGradient>
    </defs>
    <rect width="800" height="450" fill={`url(#g-${id})`} />
    {[80, 150, 220, 290, 360].map((r) => <circle cx="400" cy="225" r={r} fill="none" stroke="currentColor" stroke-opacity="0.12" stroke-width="1" />)}
    <line x1="0" y1="225" x2="800" y2="225" stroke="currentColor" stroke-opacity="0.08" />
    <line x1="400" y1="0" x2="400" y2="450" stroke="currentColor" stroke-opacity="0.08" />
  </svg>
  <span class="ph__id">{id}</span>
</div>

<style>
  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .ph--onyx {
    background: #11161c;
    color: var(--paper);
  }

  .ph--paper {
    background: var(--ivory);
    color: var(--ink);
  }

  .ph__rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ph__id {
    position: absolute;
    left: 1rem;
    bottom: 0.9rem;
    font-family: var(--font-body);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.45;
  }
</style>
