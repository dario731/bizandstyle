---
/**
 * OrbitCarousel — the big coverflow. Three cards visible, the active one
 * centred; follows the finger; snaps fast. Optional `details`: the active
 * card's content appears underneath as its own Flow of cards.
 */
import Flow from './Flow.astro';

interface Item {
  num?: string;
  name: string;
  line: string;
  href: string;
  tag?: string;
}
interface Detail {
  intro: string;
  groups: readonly { title: string; items: readonly string[] }[];
  note?: string;
  href?: string;
  hrefLabel?: string;
}
interface Props {
  eyebrow?: string;
  title?: readonly string[];
  items: readonly Item[];
  details?: readonly Detail[];
  id?: string;
}
const { eyebrow = 'The platform', title = ['Everything', 'connects.'], items, details, id = 'orbit' } = Astro.props;
---

<section class="cf ground-onyx" {id} aria-labelledby={`${id}-title`} data-flow data-flow-wrap="true" data-flow-auto={details ? undefined : '4500'}>
  <div class="container cf__head">
    <div>
      <p class="eyebrow eyebrow--marker" data-cf-reveal>{eyebrow}</p>
      <h2 id={`${id}-title`} class="cf__title" data-cf-reveal>
        {title.map((l, i) => <span class:list={{ thin: i > 0 }}>{l}</span>)}
      </h2>
    </div>
    <div class="cf__nav" data-cf-reveal>
      <button class="cf__btn" type="button" data-flow-prev aria-label="Previous"><svg viewBox="0 0 16 16"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
      <span class="num" data-flow-counter>01 / {String(items.length).padStart(2, '0')}</span>
      <button class="cf__btn" type="button" data-flow-next aria-label="Next"><svg viewBox="0 0 16 16"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
    </div>
  </div>

  <div class="cf__stage" data-flow-stage tabindex="0" aria-roledescription="carousel">
    <div class="cf__track">
      {
        items.map((it, i) => (
          <a class="cf__card" href={details ? '#' : it.href} data-flow-card data-index={i} aria-label={it.name} data-track="navigation_click" data-track-cta-name={it.name}>
            <span class="cf__top"><span class="num">{it.num ?? String(i + 1).padStart(2, '0')}</span>{it.tag && <span class="cf__tag">{it.tag}</span>}</span>
            <span class="cf__name">{it.name}</span>
            <span class="cf__line">{it.line}</span>
            <span class="cf__more">{details ? 'Select' : 'Open'}<svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></span>
          </a>
        ))
      }
    </div>
  </div>
  <p class="cf__hint num" aria-hidden="true">Swipe · drag · arrows</p>

  {
    details && (
      <div class="container cf__details" aria-live="polite">
        {details.map((d, i) => (
          <div class="cf__detail" data-flow-detail={i} hidden={i !== 0}>
            <p class="cf__intro">{d.intro}</p>
            <Flow size="sm" label="Everything inside · swipe" numbered={false} items={d.groups.flatMap((g) => g.items.map((it) => ({ name: it, tag: g.title })))} />
            {d.note && <p class="cf__note small">{d.note}</p>}
            {d.href && (
              <a class="link" href={d.href}>
                {d.hrefLabel ?? 'On the platform'}<svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
              </a>
            )}
          </div>
        ))}
      </div>
    )
  }
</section>

<style>
  .cf {
    padding-block: var(--space-section-sm);
    overflow: hidden;
  }

  .cf__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .cf__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118, 'wght' 760;
    font-stretch: 118%;
    font-weight: 760;
    font-size: var(--fs-2);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-top: var(--space-3);
  }

  .cf__title span { display: block; }

  .cf__nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: none;
  }

  .cf__btn {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(244, 246, 248, 0.3);
    border-radius: 2px;
    display: grid;
    place-items: center;
    color: var(--paper);
    transition: border-color 0.2s, background 0.2s;
  }

  .cf__btn:hover { border-color: var(--brass); background: rgba(142, 197, 232, 0.1); }
  .cf__btn svg { width: 1rem; height: 1rem; }

  .cf__stage {
    position: relative;
    height: 16.5rem;
    perspective: 1400px;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    outline: none;
  }

  .cf__stage.is-dragging { cursor: grabbing; }
  .cf__stage:focus-visible { box-shadow: inset 0 0 0 2px var(--brass); }

  .cf__track {
    position: absolute;
    left: 50%;
    top: 0;
    height: 100%;
    transform-style: preserve-3d;
  }

  .cf__card {
    --w: min(22rem, 64vw);
    position: absolute;
    left: calc(var(--w) / -2);
    top: 0;
    width: var(--w);
    height: 16rem;
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1.2rem 1.3rem;
    border: 1px solid rgba(244, 246, 248, 0.14);
    border-radius: 2px;
    background: linear-gradient(160deg, rgba(24, 30, 38, 0.96), rgba(11, 14, 19, 0.98));
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45);
    color: var(--paper);
    will-change: transform;
    transition: border-color 0.3s;
  }

  .cf__card.is-active { border-color: var(--brass); }

  .cf__top { display: flex; justify-content: space-between; align-items: center; }

  .cf__tag {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .cf__name {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 116, 'wght' 720;
    font-stretch: 116%;
    font-size: 1.35rem;
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .cf__line { color: var(--stone); font-size: 0.88rem; }

  .cf__more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .cf__more .btn__arrow { width: 0.9em; height: 0.9em; }

  .cf__hint {
    text-align: center;
    color: rgba(244, 246, 248, 0.4);
    margin-top: var(--space-3);
  }

  .cf__details {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(244, 246, 248, 0.12);
  }

  .cf__detail {
    display: grid;
    gap: var(--space-5);
    animation: cf-in 0.45s var(--ease-out);
  }

  @keyframes cf-in { from { opacity: 0; transform: translateY(10px); } }

  .cf__intro { max-width: 70ch; color: var(--stone); }

  .cf__note {
    padding: var(--space-4);
    border-left: 2px solid var(--brass);
    background: rgba(244, 246, 248, 0.04);
    color: var(--stone);
    max-width: 78ch;
  }

  @media (max-width: 720px) {
    .cf__stage { height: 15rem; }
    .cf__card { height: 14.5rem; padding: 0.9rem; }
    .cf__name { font-size: 1.05rem; margin-top: 1rem; }
  }
</style>

<script>
  import { gsap } from '@lib/motion';
  document.querySelectorAll<HTMLElement>('.cf').forEach((root) => {
    gsap.from(root.querySelectorAll('[data-cf-reveal]'), { autoAlpha: 0, y: 20, stagger: 0.1, scrollTrigger: { trigger: root, start: 'top 78%' } });
    gsap.from(root.querySelector('.cf__stage'), { autoAlpha: 0, y: 40, duration: 1.1, scrollTrigger: { trigger: root, start: 'top 70%' } });
  });
</script>
