---
/**
 * OrbitCarousel — now a coverflow. Three cards visible at once: the active
 * one centred and bright, the neighbours to each side. Arrows, drag, swipe,
 * keyboard. Optional `details`: a panel under the row that shows the active
 * card's content (used on /solutions).
 */
interface Item {
  num?: string;
  name: string;
  line: string;
  href: string;
  tag?: string;
}
interface Detail {
  intro: string;
  groups: readonly { title: string; items: readonly string[] }[];
  note?: string;
  href?: string;
  hrefLabel?: string;
}
interface Props {
  eyebrow?: string;
  title?: readonly string[];
  items: readonly Item[];
  details?: readonly Detail[];
  id?: string;
}
const { eyebrow = 'The platform', title = ['Everything', 'connects.'], items, details, id = 'orbit' } = Astro.props;
---

<section class="cf ground-onyx" {id} aria-labelledby={`${id}-title`} data-coverflow data-has-details={details ? 'true' : undefined}>
  <div class="container cf__head">
    <div>
      <p class="eyebrow eyebrow--marker" data-cf-reveal>{eyebrow}</p>
      <h2 id={`${id}-title`} class="cf__title" data-cf-reveal>
        {title.map((l, i) => <span class:list={{ thin: i > 0 }}>{l}</span>)}
      </h2>
    </div>
    <div class="cf__nav" data-cf-reveal>
      <button class="cf__btn" type="button" data-cf-prev aria-label="Previous"><svg viewBox="0 0 16 16"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
      <span class="num" data-cf-counter>01 / {String(items.length).padStart(2, '0')}</span>
      <button class="cf__btn" type="button" data-cf-next aria-label="Next"><svg viewBox="0 0 16 16"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
    </div>
  </div>

  <div class="cf__stage" data-cf-stage tabindex="0" aria-roledescription="carousel">
    <div class="cf__track" data-cf-track>
      {
        items.map((it, i) => (
          <a class="cf__card" href={details ? '#' : it.href} data-cf-card data-index={i} aria-label={it.name} data-track="navigation_click" data-track-cta-name={it.name}>
            <span class="cf__top"><span class="num">{it.num ?? String(i + 1).padStart(2, '0')}</span>{it.tag && <span class="cf__tag">{it.tag}</span>}</span>
            <span class="cf__name">{it.name}</span>
            <span class="cf__line">{it.line}</span>
            <span class="cf__more">{details ? 'Select' : 'Open'}<svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></span>
          </a>
        ))
      }
    </div>
  </div>

  {
    details && (
      <div class="container cf__details" data-cf-details aria-live="polite">
        {details.map((d, i) => (
          <div class="cf__detail" data-cf-detail={i} hidden={i !== 0}>
            <p class="cf__intro">{d.intro}</p>
            <div class="cf__groups">
              {d.groups.map((g) => (
                <div class="cf__group">
                  <h3 class="eyebrow">{g.title}</h3>
                  <ul role="list">{g.items.map((it) => <li>{it}</li>)}</ul>
                </div>
              ))}
            </div>
            {d.note && <p class="cf__note small">{d.note}</p>}
            {d.href && (
              <a class="link" href={d.href}>
                {d.hrefLabel ?? 'On the platform'}<svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
              </a>
            )}
          </div>
        ))}
      </div>
    )
  }
</section>

<style>
  .cf {
    padding-block: var(--space-section-sm);
    overflow: hidden;
  }

  .cf__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }

  .cf__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118, 'wght' 760;
    font-stretch: 118%;
    font-weight: 760;
    font-size: var(--fs-2);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-top: var(--space-3);
  }

  .cf__title span {
    display: block;
  }

  .cf__nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex: none;
  }

  .cf__btn {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(244, 246, 248, 0.3);
    border-radius: 2px;
    display: grid;
    place-items: center;
    color: var(--paper);
    transition: border-color 0.2s, background 0.2s;
  }

  .cf__btn:hover {
    border-color: var(--brass);
    background: rgba(142, 197, 232, 0.1);
  }

  .cf__btn svg {
    width: 1rem;
    height: 1rem;
  }

  .cf__stage {
    position: relative;
    height: 16.5rem;
    perspective: 1400px;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    outline: none;
  }

  .cf__stage.is-dragging {
    cursor: grabbing;
  }

  .cf__stage:focus-visible {
    box-shadow: inset 0 0 0 2px var(--brass);
  }

  .cf__track {
    position: absolute;
    left: 50%;
    top: 0;
    height: 100%;
    transform-style: preserve-3d;
  }

  .cf__card {
    --w: min(22rem, 78vw);
    position: absolute;
    left: calc(var(--w) / -2);
    top: 0;
    width: var(--w);
    height: 16rem;
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1.2rem 1.3rem;
    border: 1px solid rgba(244, 246, 248, 0.14);
    border-radius: 2px;
    background: linear-gradient(160deg, rgba(24, 30, 38, 0.96), rgba(11, 14, 19, 0.98));
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45);
    color: var(--paper);
    transition: transform 0.55s var(--ease-out), opacity 0.4s, filter 0.4s, border-color 0.3s;
    will-change: transform;
  }

  .cf__card.is-active {
    border-color: var(--brass);
  }

  .cf__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cf__tag {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .cf__name {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 116, 'wght' 720;
    font-stretch: 116%;
    font-size: 1.35rem;
    line-height: 1.02;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .cf__line {
    color: var(--stone);
    font-size: 0.88rem;
  }

  .cf__more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .cf__more .btn__arrow {
    width: 0.9em;
    height: 0.9em;
  }

  .cf__details {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid rgba(244, 246, 248, 0.12);
  }

  .cf__detail {
    display: grid;
    gap: var(--space-5);
    animation: cf-in 0.45s var(--ease-out);
  }

  @keyframes cf-in {
    from { opacity: 0; transform: translateY(10px); }
  }

  .cf__intro {
    max-width: 70ch;
    color: var(--stone);
  }

  .cf__groups {
    display: grid;
    gap: var(--space-4);
  }

  .cf__group {
    display: grid;
    gap: 0.4rem;
    padding-top: var(--space-3);
    border-top: 1px solid rgba(244, 246, 248, 0.12);
  }

  .cf__group li {
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(244, 246, 248, 0.08);
    font-size: 0.92rem;
  }

  .cf__note {
    padding: var(--space-4);
    border-left: 2px solid var(--brass);
    background: rgba(244, 246, 248, 0.04);
    color: var(--stone);
    max-width: 78ch;
  }

  @media (min-width: 900px) {
    .cf__groups {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-6);
    }
  }

  @media (max-width: 720px) {
    .cf__stage { height: 15rem; }
    .cf__card { height: 14.5rem; padding: 1rem; }
    .cf__name { font-size: 1.15rem; margin-top: 1rem; }
  }
</style>

<script>
  import { gsap } from '@lib/motion';

  document.querySelectorAll<HTMLElement>('[data-coverflow]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-cf-stage]')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-cf-card]'));
    const details = Array.from(root.querySelectorAll<HTMLElement>('[data-cf-detail]'));
    const counter = root.querySelector<HTMLElement>('[data-cf-counter]');
    const N = cards.length;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;
    let timer = 0;

    gsap.from(root.querySelectorAll('[data-cf-reveal]'), { autoAlpha: 0, y: 20, stagger: 0.1, scrollTrigger: { trigger: root, start: 'top 78%' } });
    gsap.from(stage, { autoAlpha: 0, y: 40, duration: 1.1, scrollTrigger: { trigger: root, start: 'top 70%' } });

    const gap = () => Math.min(cards[0].offsetWidth * 0.86, window.innerWidth * 0.42);
    const render = () => {
      cards.forEach((c, i) => {
        let d = i - active;
        if (d > N / 2) d -= N;
        if (d < -N / 2) d += N;
        const ad = Math.abs(d);
        const visible = ad <= 2;
        c.style.transform = `translateX(${d * gap()}px) translateZ(${-ad * 160}px) rotateY(${-d * 14}deg) scale(${1 - ad * 0.08})`;
        c.style.opacity = visible ? String(1 - ad * 0.32) : '0';
        c.style.filter = ad > 0 ? `blur(${ad * 0.6}px)` : 'none';
        c.style.zIndex = String(10 - ad);
        c.style.pointerEvents = visible ? 'auto' : 'none';
        c.classList.toggle('is-active', d === 0);
        c.tabIndex = d === 0 ? 0 : -1;
      });
      details.forEach((p, i) => (p.hidden = i !== active));
      if (counter) counter.textContent = `${String(active + 1).padStart(2, '0')} / ${String(N).padStart(2, '0')}`;
    };
    const go = (i: number) => { active = ((i % N) + N) % N; render(); restart(); };
    const restart = () => { clearInterval(timer); if (!still && !root.dataset.hasDetails) timer = window.setInterval(() => go(active + 1), 4500); };

    root.querySelector('[data-cf-prev]')?.addEventListener('click', () => go(active - 1));
    root.querySelector('[data-cf-next]')?.addEventListener('click', () => go(active + 1));
    cards.forEach((c, i) => c.addEventListener('click', (e) => {
      if (i !== active) { e.preventDefault(); go(i); return; }
      if (root.dataset.hasDetails) { e.preventDefault(); root.querySelector<HTMLElement>('[data-cf-details]')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    }));
    stage.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') go(active + 1); if (e.key === 'ArrowLeft') go(active - 1); });

    let x0 = 0, dragging = false, moved = false;
    stage.addEventListener('pointerdown', (e) => { dragging = true; moved = false; x0 = e.clientX; stage.classList.add('is-dragging'); });
    stage.addEventListener('pointermove', (e) => { if (dragging && Math.abs(e.clientX - x0) > 8) moved = true; });
    const end = (e: PointerEvent) => { if (!dragging) return; dragging = false; stage.classList.remove('is-dragging'); const dx = e.clientX - x0; if (Math.abs(dx) > 40) go(active + (dx < 0 ? 1 : -1)); };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);
    stage.addEventListener('click', (e) => { if (moved) { e.preventDefault(); e.stopPropagation(); } }, true);
    stage.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY) && Math.abs(e.deltaX) > 20) { e.preventDefault(); go(active + (e.deltaX > 0 ? 1 : -1)); } }, { passive: false });

    window.addEventListener('resize', render);
    new IntersectionObserver((es) => (es[0].isIntersecting ? restart() : clearInterval(timer))).observe(root);
    render();
  });
</script>
