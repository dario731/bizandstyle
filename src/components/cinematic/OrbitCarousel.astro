---
/**
 * OrbitCarousel — cards on a 3D ring that drifts, and that you can drag or
 * scroll sideways. The front card is bright; the back ones recede.
 */
interface Item {
  num?: string;
  name: string;
  line: string;
  href: string;
  tag?: string;
}
interface Props {
  eyebrow?: string;
  title?: readonly string[];
  items: readonly Item[];
  id?: string;
}
const { eyebrow = 'The platform', title = ['Everything', 'connects.'], items, id = 'orbit' } = Astro.props;
---

<section class="oc ground-onyx" {id} aria-labelledby={`${id}-title`} data-orbit>
  <div class="container oc__head">
    <p class="eyebrow eyebrow--marker" data-oc-reveal>{eyebrow}</p>
    <h2 id={`${id}-title`} class="oc__title" data-oc-reveal>
      {title.map((l, i) => <span class:list={{ thin: i > 0 }}>{l}</span>)}
    </h2>
  </div>

  <div class="oc__stage" data-oc-stage>
    <div class="oc__ring" data-oc-ring style={`--count:${items.length}`}>
      {
        items.map((it, i) => (
          <a class="oc__card" href={it.href} data-oc-card style={`--i:${i}`} data-track="navigation_click" data-track-cta-name={it.name}>
            <span class="oc__top"><span class="num">{it.num ?? String(i + 1).padStart(2, '0')}</span>{it.tag && <span class="oc__tag">{it.tag}</span>}</span>
            <span class="oc__name">{it.name}</span>
            <span class="oc__line">{it.line}</span>
            <svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
          </a>
        ))
      }
    </div>
    <div class="oc__floor" aria-hidden="true"></div>
  </div>

  <div class="container oc__foot">
    <p class="num oc__hint">Drag · scroll sideways · arrows</p>
    <div class="oc__nav">
      <button class="oc__btn" type="button" data-oc-prev aria-label="Previous"><svg viewBox="0 0 16 16"><path d="M10 3L5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
      <button class="oc__btn" type="button" data-oc-next aria-label="Next"><svg viewBox="0 0 16 16"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></button>
    </div>
  </div>
</section>

<style>
  .oc {
    padding-block: clamp(5rem, 12vh, 9rem) clamp(3rem, 6vh, 5rem);
    overflow: hidden;
  }

  .oc__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: clamp(1rem, 3vh, 2rem);
  }

  .oc__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118, 'wght' 760;
    font-stretch: 118%;
    font-weight: 760;
    font-size: clamp(2.4rem, 5.6vw, 5.4rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .oc__title span {
    display: block;
  }

  .oc__stage {
    position: relative;
    height: clamp(22rem, 52vh, 30rem);
    perspective: 1500px;
    perspective-origin: 50% 40%;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }

  .oc__stage.is-dragging {
    cursor: grabbing;
  }

  .oc__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    --radius: 560px;
  }

  .oc__card {
    --w: 18rem;
    position: absolute;
    left: calc(var(--w) / -2);
    top: -9rem;
    width: var(--w);
    height: 18rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.4rem;
    border-radius: 16px;
    border: 1px solid rgba(250, 246, 239, 0.14);
    background: linear-gradient(160deg, rgba(30, 28, 24, 0.92), rgba(14, 13, 11, 0.96));
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45);
    color: var(--paper);
    transform: rotateY(calc(var(--i) * (360deg / var(--count)))) translateZ(var(--radius));
    backface-visibility: hidden;
    -webkit-box-reflect: below 6px linear-gradient(transparent 70%, rgba(0, 0, 0, 0.25));
    transition: border-color 0.4s;
  }

  .oc__card:hover {
    border-color: var(--brass);
  }

  .oc__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .oc__tag {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .oc__name {
    margin-top: auto;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118, 'wght' 720;
    font-stretch: 118%;
    font-size: 1.5rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    padding-top: 4.5rem;
  }

  .oc__line {
    color: var(--stone);
    font-size: 0.9rem;
  }

  .oc__card .btn__arrow {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    width: 1rem;
    height: 1rem;
    opacity: 0.6;
  }

  .oc__floor {
    position: absolute;
    inset: auto 0 0 0;
    height: 40%;
    background: radial-gradient(50% 60% at 50% 100%, rgba(184, 151, 90, 0.12), transparent 70%);
    pointer-events: none;
  }

  .oc__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .oc__hint {
    color: rgba(250, 246, 239, 0.45);
  }

  .oc__nav {
    display: flex;
    gap: 0.5rem;
  }

  .oc__btn {
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgba(250, 246, 239, 0.3);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--paper);
    transition: border-color 0.3s, background 0.3s;
  }

  .oc__btn:hover {
    border-color: var(--paper);
    background: rgba(250, 246, 239, 0.08);
  }

  .oc__btn svg {
    width: 1rem;
    height: 1rem;
  }

  @media (max-width: 720px) {
    .oc__ring { --radius: 330px; }
    .oc__card { --w: 14rem; height: 15rem; top: -7.5rem; padding: 1.1rem; }
    .oc__name { font-size: 1.2rem; padding-top: 3rem; }
    .oc__stage { height: 20rem; perspective: 1000px; }
  }
</style>

<script>
  import { gsap } from '@lib/motion';

  document.querySelectorAll<HTMLElement>('[data-orbit]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-oc-stage]')!;
    const ring = root.querySelector<HTMLElement>('[data-oc-ring]')!;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-oc-card]'));
    const N = cards.length;
    const step = 360 / N;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    gsap.from(root.querySelectorAll('[data-oc-reveal]'), { autoAlpha: 0, y: 24, stagger: 0.12, scrollTrigger: { trigger: root, start: 'top 75%' } });
    gsap.from(stage, { autoAlpha: 0, y: 60, duration: 1.4, scrollTrigger: { trigger: root, start: 'top 65%' } });

    let angle = 0, velocity = 0, dragging = false, lastX = 0, active = false, idle = 0;
    const apply = () => {
      ring.style.transform = `rotateY(${angle}deg)`;
      cards.forEach((c, i) => {
        // facing = how much this card faces the viewer (1 front, -1 back)
        const a = (((i * step + angle) % 360) + 360) % 360;
        const facing = Math.cos((a * Math.PI) / 180);
        c.style.opacity = String(0.25 + Math.max(0, facing) * 0.75);
        c.style.filter = facing < 0.2 ? `blur(${(0.2 - facing) * 3}px)` : 'none';
        c.tabIndex = facing > 0.7 ? 0 : -1;
      });
    };
    const loop = () => {
      if (!active) return;
      if (!dragging) {
        idle++;
        angle += velocity;
        velocity *= 0.94;
        if (!still && Math.abs(velocity) < 0.02 && idle > 90) angle -= 0.045; // slow drift
      }
      apply();
      requestAnimationFrame(loop);
    };
    new IntersectionObserver((es) => { active = es[0].isIntersecting; if (active) requestAnimationFrame(loop); }).observe(root);

    stage.addEventListener('pointerdown', (e) => { dragging = true; lastX = e.clientX; velocity = 0; stage.classList.add('is-dragging'); stage.setPointerCapture(e.pointerId); });
    stage.addEventListener('pointermove', (e) => { if (!dragging) return; const dx = e.clientX - lastX; lastX = e.clientX; angle += dx * 0.25; velocity = dx * 0.25; idle = 0; });
    const end = () => { dragging = false; stage.classList.remove('is-dragging'); };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);
    stage.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) { e.preventDefault(); angle -= e.deltaX * 0.2; idle = 0; } }, { passive: false });
    // suppress click after a drag
    let downX = 0;
    stage.addEventListener('pointerdown', (e) => (downX = e.clientX), true);
    stage.addEventListener('click', (e) => { if (Math.abs((e as MouseEvent).clientX - downX) > 6) e.preventDefault(); }, true);

    root.querySelector('[data-oc-prev]')?.addEventListener('click', () => { gsap.to({ v: 0 }, { v: 1, duration: 0.8, ease: 'power3.out', onUpdate() { angle += (step / 12); }, }); idle = 0; });
    root.querySelector('[data-oc-next]')?.addEventListener('click', () => { gsap.to({ v: 0 }, { v: 1, duration: 0.8, ease: 'power3.out', onUpdate() { angle -= (step / 12); }, }); idle = 0; });
    apply();
  });
</script>
