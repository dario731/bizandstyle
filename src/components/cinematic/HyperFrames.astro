---
/**
 * HyperFrames — a pinned scene you travel through. Each frame sits deeper in
 * 3D space; scrolling moves the camera forward so frames grow, pass and give
 * way to the next. Rings form the tunnel. Works without JS as a plain list.
 */
interface Frame {
  title: string;
  line?: string;
  href?: string;
  eyebrow?: string;
}
interface Props {
  eyebrow?: string;
  intro?: string;
  frames: readonly Frame[];
  id?: string;
  outro?: { title: string; href?: string; label?: string };
}
const { eyebrow = 'Enter the journey', intro, frames, id = 'hyperframes', outro } = Astro.props;
const N = frames.length + (outro ? 1 : 0);
---

<section class="hf ground-onyx" {id} data-hyperframes style={`--n:${N}`} aria-label={eyebrow}>
  <div class="hf__sticky">
    <div class="hf__stage" data-hf-stage>
      {Array.from({ length: N * 2 + 2 }, (_, k) => <span class="hf__ring" data-hf-ring={k} aria-hidden="true"></span>)}
      {
        frames.map((f, i) => (
          <article class="hf__frame" data-hf-frame={i}>
            <p class="num hf__num">{String(i + 1).padStart(2, '0')} / {String(frames.length).padStart(2, '0')}</p>
            {f.eyebrow && <p class="eyebrow hf__eyebrow">{f.eyebrow}</p>}
            <h3 class="hf__title">{f.title}</h3>
            {f.line && <p class="hf__line">{f.line}</p>}
            {f.href && (
              <a class="link hf__link" href={f.href} tabindex="-1">
                Explore<svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
              </a>
            )}
          </article>
        ))
      }
      {
        outro && (
          <article class="hf__frame hf__frame--outro" data-hf-frame={frames.length}>
            <h3 class="hf__title hf__title--big">{outro.title}</h3>
            {outro.href && (
              <a class="btn btn--solid" href={outro.href}>
                <span class="btn__ring" aria-hidden="true"></span>{outro.label ?? 'Continue'}
              </a>
            )}
          </article>
        )
      }
    </div>
    <div class="hf__hud" aria-hidden="true">
      <p class="eyebrow eyebrow--marker">{eyebrow}</p>
      {intro && <p class="hf__intro small">{intro}</p>}
      <div class="hf__rail">
        {Array.from({ length: N }, (_, i) => <span class="hf__tick" data-hf-tick={i}></span>)}
      </div>
      <p class="hf__hint num">Scroll to enter</p>
    </div>
  </div>
</section>

<style>
  .hf {
    position: relative;
    height: calc((var(--n) + 1) * 100vh);
    height: calc((var(--n) + 1) * 100svh);
  }

  .hf__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(60% 50% at 50% 50%, rgba(184, 151, 90, 0.08), transparent 70%),
      var(--onyx);
  }

  .hf__stage {
    position: absolute;
    inset: 0;
    perspective: 1100px;
    perspective-origin: 50% 50%;
    transform-style: preserve-3d;
  }

  .hf__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(80vmin, 900px);
    aspect-ratio: 1;
    margin: calc(min(80vmin, 900px) / -2) 0 0 calc(min(80vmin, 900px) / -2);
    border-radius: 50%;
    border: 1px solid rgba(250, 246, 239, 0.1);
    box-shadow: 0 0 60px rgba(184, 151, 90, 0.06) inset;
    will-change: transform, opacity;
  }

  .hf__ring:nth-child(4n) {
    border-color: rgba(184, 151, 90, 0.35);
  }

  .hf__frame {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(88vw, 60rem);
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-4);
    padding: var(--space-6);
    will-change: transform, opacity;
    pointer-events: none;
  }

  .hf__frame.is-front {
    pointer-events: auto;
  }

  .hf__num {
    color: var(--brass);
  }

  .hf__eyebrow {
    color: var(--stone);
  }

  .hf__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118, 'wght' 760;
    font-stretch: 118%;
    font-weight: 760;
    font-size: clamp(2.2rem, 6.2vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    text-wrap: balance;
    max-width: 16ch;
  }

  .hf__title--big {
    font-size: clamp(2.6rem, 8vw, 8rem);
  }

  .hf__line {
    color: var(--stone);
    max-width: 44ch;
    font-size: clamp(0.95rem, 1.25vw, 1.15rem);
  }

  .hf__hud {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: calc(4.5rem + var(--space-5));
    display: grid;
    gap: var(--space-3);
    pointer-events: none;
  }

  .hf__intro {
    color: var(--stone);
    max-width: 34ch;
  }

  .hf__rail {
    position: absolute;
    right: 0;
    top: calc(50vh - 4.5rem - var(--space-5) - 5rem);
    display: grid;
    gap: 0.6rem;
  }

  .hf__tick {
    width: 1.6rem;
    height: 1px;
    background: rgba(250, 246, 239, 0.25);
    transition: background 0.4s, width 0.4s var(--ease-out);
  }

  .hf__tick.is-active {
    width: 3rem;
    background: var(--brass);
  }

  .hf__hint {
    position: absolute;
    left: 0;
    top: calc(100vh - 4.5rem - var(--space-5) - 7rem);
    color: rgba(250, 246, 239, 0.45);
    animation: hf-hint 2.4s ease-in-out infinite;
  }

  @keyframes hf-hint {
    50% { transform: translateY(6px); opacity: 0.5; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hf { height: auto; }
    .hf__sticky { position: relative; height: auto; overflow: visible; padding-block: var(--space-section); }
    .hf__stage { position: relative; perspective: none; display: grid; gap: var(--space-8); }
    .hf__ring { display: none; }
    .hf__frame { position: relative; left: auto; top: auto; transform: none; opacity: 1 !important; pointer-events: auto; }
    .hf__hud { position: relative; top: auto; left: auto; right: auto; margin-bottom: var(--space-7); }
    .hf__rail, .hf__hint { display: none; }
  }
</style>

<script>
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-hyperframes]').forEach((root) => {
    if (still) return;
    const frames = Array.from(root.querySelectorAll<HTMLElement>('[data-hf-frame]'));
    const rings = Array.from(root.querySelectorAll<HTMLElement>('[data-hf-ring]'));
    const ticks = Array.from(root.querySelectorAll<HTMLElement>('[data-hf-tick]'));
    const N = frames.length;
    const D = 1400; // depth between frames (px)
    const RING_STEP = D / 2;
    let active = false;

    const render = () => {
      const r = root.getBoundingClientRect();
      const vh = window.innerHeight;
      const total = r.height - vh;
      const p = Math.min(1, Math.max(0, -r.top / total));
      const cam = p * (N - 1) * D;

      frames.forEach((f, i) => {
        const z = cam - i * D; // negative = ahead of camera
        let o = 0;
        if (z < -2300) o = 0;
        else if (z < -1000) o = (z + 2300) / 1300;
        else if (z < 120) o = 1;
        else if (z < 420) o = 1 - (z - 120) / 300;
        const zc = Math.min(z, 600);
        f.style.transform = `translate(-50%, -50%) translateZ(${zc}px)`;
        f.style.opacity = String(o);
        f.style.filter = z > 120 ? `blur(${Math.min(10, (z - 120) / 25)}px)` : z < -1400 ? `blur(${Math.min(6, (-1400 - z) / 150)}px)` : 'none';
        f.classList.toggle('is-front', o > 0.6 && z <= 120);
      });
      const cur = Math.round(p * (N - 1));
      ticks.forEach((t, i) => t.classList.toggle('is-active', i === cur));

      const span = rings.length * RING_STEP;
      rings.forEach((ring, k) => {
        let z = ((cam - k * RING_STEP) % span + span) % span; // 0..span, wraps
        z = z - span + 900; // -span+900 .. 900
        const o = z > 700 ? 0 : z < -3200 ? 0 : z < -2000 ? (z + 3200) / 1200 * 0.6 : 0.6;
        ring.style.transform = `translateZ(${z}px)`;
        ring.style.opacity = String(o);
      });
    };

    let raf = 0;
    const onScroll = () => { if (!active) return; cancelAnimationFrame(raf); raf = requestAnimationFrame(render); };
    new IntersectionObserver((es) => { active = es[0].isIntersecting; if (active) render(); }, { rootMargin: '20% 0px' }).observe(root);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    render();
  });
</script>
