---
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/editorial/EditorialHero.astro';
import Statement from '@components/editorial/Statement.astro';
import ProseSections from '@components/editorial/ProseSections.astro';
import ModuleGrid from '@components/editorial/ModuleGrid.astro';
import FaqBlock from '@components/editorial/FaqBlock.astro';
import ContextualCta from '@components/conversion/ContextualCta.astro';
import { byDivision, divisionMeta, type Division } from '@data/services';
import { webPageLd, breadcrumbLd, faqLd, itemListLd, graph, absoluteUrl } from '@lib/seo';

const path = '/divisions';
const title = 'Three Divisions · One Platform | BIZ & STYLE';
const description = 'Advisory, Commerce and Luxury — three operating engines of the BIZ & STYLE platform in Miami. +1 305-549-4289.';
const divisions: { id: Division; num: string; line: string; overview: string; visual: string }[] = [
  { id: 'advisory', num: '01', line: 'Strategy that ends in execution.', overview: 'Business strategy, international expansion, fractional executive leadership, business development and digital growth — delivered by a team that operates in-market.', visual: 'orbit' },
  { id: 'commerce', num: '02', line: 'From product to market.', overview: 'Import and export, distribution, marketplaces, domestic and bonded warehousing in Miami, fulfillment and brand representation for the Americas.', visual: 'flow' },
  { id: 'luxury', num: '03', line: 'Business development at the highest level.', overview: 'Miami luxury and pre-construction real estate, developer partnerships and a seven-vertical ecosystem serving the same high-net-worth client.', visual: 'grid' },
];
const faqs = [
  { q: 'What are the three divisions?', a: 'B&S Advisory (strategy and growth), B&S Commerce (trade and distribution) and B&S Luxury (real estate and high-value ecosystems).' },
  { q: 'Is this the same as The Platform page?', a: 'No. `/platform` explains who BIZ & STYLE is and how the organisation is structured. `/divisions` helps you choose which operating engine to start with.' },
  { q: 'Are Advisory, Commerce and Luxury separate companies?', a: 'They are operating divisions of one platform — sharing one team, infrastructure and network, with dedicated entities and JVs when a market or venture needs them.' },
  { q: 'Where should an international brand start?', a: 'Often Advisory (entry + BD) plus Commerce (distribution / bonded hub). Luxury clients may start on B&S Luxury / bns-luxury.com for property search.' },
  { q: 'How do I contact the right team?', a: 'One front door: +1 305-549-4289 or info@bizandstyledna.com — we route internally.' },
];
const relatedLinks = [
  { href: '/platform', label: 'who we are — The Platform', line: 'Identity and org structure — not this chooser.' },
  { href: '/advisory', label: 'B&S Advisory', line: 'Strategy and growth — start here for entry and BD.' },
  { href: '/commerce', label: 'B&S Commerce', line: 'Trade and distribution — from product to market.' },
  { href: '/luxury', label: 'B&S Luxury', line: 'Real estate and high-value ecosystems.' },
  { href: '/', label: 'business development platform overview', line: 'The home brand-and-offers story.' },
];
const sections = [
  {
    title: 'B&S Advisory — strategy & growth',
    paragraphs: [
      'Strategy that ends in execution: international expansion, fractional leadership, business development and digital — operators in Miami, not advisors at a distance. United States, Latin America and Europe share one Advisory calendar from Miami Beach.',
      'An international brand often starts here for entry and BD, then layers Commerce when product has to move. Explore B&S Advisory when the brief is capability and roadmap.',
    ],
  },
  {
    title: 'B&S Commerce — trade & distribution',
    paragraphs: [
      'From product to market: import/export, distribution, marketplaces, bonded warehousing and fulfillment from Miami for the Americas. The physical engine that lets a brand operate northbound and southbound from one hub.',
      'Start on B&S Commerce when inventory, channels and the bonded hub are the first conversation.',
    ],
  },
  {
    title: 'B&S Luxury — real estate & high-value ecosystems',
    paragraphs: [
      'Luxury real estate and a seven-vertical ecosystem for high-net-worth clients in Miami. Property search lives on bns-luxury.com. This chooser points at the division — not a second listings site.',
      'Luxury clients may start on B&S Luxury / bns-luxury.com for property search, then use the platform when the brief becomes partnership or acquisition infrastructure.',
    ],
  },
  {
    title: 'How divisions differ from The Platform page',
    paragraphs: [
      '/platform explains who BIZ & STYLE is and how the organisation is structured — identity, Investor Journey™, Business · Wealth · Lifestyle. /divisions is the chooser: which operating engine to start with among Advisory, Commerce and Luxury.',
      'They are not three companies. They are operating divisions of one platform in Miami — sharing one team, infrastructure and network across the Americas, the United States, Latin America and Europe — with dedicated entities and JVs when a market or venture needs them. One front door: +1 305-549-4289 or info@bizandstyledna.com.',
    ],
  },
];
const jsonLd = graph(
  webPageLd({ name: title, description, path, type: 'CollectionPage' }),
  itemListLd(`${absoluteUrl(path)}#list`, [
    { name: 'B&S Advisory', url: absoluteUrl('/advisory') },
    { name: 'B&S Commerce', url: absoluteUrl('/commerce') },
    { name: 'B&S Luxury', url: absoluteUrl('/luxury') },
  ]),
  breadcrumbLd([{ name: 'Divisions', path }]),
  faqLd(faqs, `${absoluteUrl(path)}#faq`),
);
---

<BaseLayout {title} {description} {path} pageType="divisions" {jsonLd}>
  <EditorialHero eyebrow="Divisions" title={['Three engines.', 'Choose where to start.']} lede="Advisory, Commerce and Luxury — three operating engines of one BIZ & STYLE platform in Miami. Not three companies. One system." ground="onyx" crumbs={[{ name: 'Divisions', path }]} size="display-2" toc={false} tight />

  <section class="ground-onyx dv-tiles" aria-label="The three divisions">
    <div class="container">
      <ol class="dv-tiles__grid" role="list">
        {divisions.map((d) => {
          const meta = divisionMeta[d.id];
          return (
            <li>
              <a class="dv-tile" href={meta.path} data-track="division_view" data-track-division={meta.name}>
                <span class="dv-tile__top"><span class="num">{d.num}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></span>
                <span class="dv-tile__name">{meta.name}</span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  <section class="section ground-onyx dv" id="choose" aria-label="Choose a division">
    <div class="container dv__grid" data-reveal-group>
      {
        divisions.map((d) => {
          const meta = divisionMeta[d.id];
          const services = byDivision(d.id);
          return (
            <a class="dv__card" href={meta.path} data-track="division_view" data-track-division={meta.name}>
              <span class="dv__top"><span class="num">{d.num}</span><span class="dv__role">{meta.role}</span></span>
              <span class="dv__name">{meta.name}</span>
              <span class="dv__line editorial">{d.line}</span>
              <span class="dv__overview">{d.overview}</span>
              <ul class="dv__services" role="list">
                {services.slice(0, 5).map((s) => <li>{s.title}</li>)}
                {services.length > 5 && <li class="dv__more-count">+ {services.length - 5} more</li>}
              </ul>
              <span class="btn btn--solid dv__btn">Enter {meta.name.replace('B&S ', '')}</span>
            </a>
          );
        })
      }
    </div>
  </section>

  <Statement eyebrow="One platform. Several entities" lines={['Shared team, infrastructure, network.']} body={['The divisions share one team, one infrastructure and one network across the Americas. Behind them sit BIZ & STYLE DNA INC. in Miami Beach and dedicated entities and joint ventures created with strategic partners — so what starts as a market-entry project can become distribution, and what starts as a property can become a business.']} ground="paper" size="display-2" />

  <ProseSections {sections} ground="onyx" idPrefix="dv" />
  <ModuleGrid eyebrow="Continue" title="Related on the platform." items={relatedLinks.map((l) => ({ name: l.label, line: l.line, href: l.href }))} columns={3} ground="paper" numbered={false} trackAs="navigation_click" />
  <FaqBlock {faqs} title="FAQ" ground="paper" />

  <ContextualCta eyebrow="Not sure which division?" title={['Tell us', "what you're building."]} primary={{ label: "Tell us what you're building", href: '/tell-us', name: 'tell_us' }} secondary={{ label: 'Solutions', href: '/solutions', name: 'solutions' }} location="divisions_cta" />
</BaseLayout>

<style>
  .dv {
    padding-top: 0;
  }
  .dv-tiles { padding-block: 0 var(--space-5); }
  .dv-tiles__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; }
  .dv-tile {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    height: 100%;
    padding: 0.75rem 0.7rem 0.85rem;
    border: 1px solid rgba(244, 246, 248, 0.14);
    border-top: 2px solid rgba(244, 246, 248, 0.5);
    border-radius: 2px;
    background: linear-gradient(170deg, #1b1c1f, #0c0c0e 70%);
  }
  .dv-tile__top { display: flex; justify-content: space-between; align-items: center; }
  .dv-tile__top svg { width: 0.9rem; height: 0.9rem; color: var(--stone); }
  .dv-tile__name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 110, 'wght' 720;
    font-stretch: 110%;
    font-size: 0.85rem;
    line-height: 1.05;
    text-transform: uppercase;
  }
  @media (min-width: 900px) { .dv-tiles { display: none; } }
  .dv :global(.eh) { padding-bottom: var(--space-4); }
  .dv__grid {
    display: grid;
    gap: var(--space-4);
  }
  .dv__card {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: clamp(1.2rem, 2vw, 1.8rem);
    border: 1px solid rgba(244, 246, 248, 0.14);
    border-radius: 2px;
    background: linear-gradient(170deg, #1b1c1f, #0c0c0e 70%);
    color: var(--paper);
    transition: border-color 0.3s, transform 0.4s var(--ease-out);
  }
  .dv__card:hover {
    border-color: rgba(244, 246, 248, 0.4);
    background: linear-gradient(170deg, #2b2c30, #131416 70%);
    transform: translateY(-4px);
  }
  .dv__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .dv__role {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .dv__name {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 116, 'wght' 720;
    font-stretch: 116%;
    font-size: 1.6rem;
    line-height: 1;
    text-transform: uppercase;
  }
  .dv__line {
    font-size: 1.2rem;
    color: var(--stone);
  }
  .dv__overview {
    font-size: 0.92rem;
    color: var(--stone);
  }
  .dv__services {
    display: grid;
    margin-top: 0.6rem;
    border-top: 1px solid rgba(244, 246, 248, 0.12);
  }
  .dv__services li {
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(244, 246, 248, 0.08);
    font-size: 0.85rem;
  }
  .dv__more-count {
    color: var(--brass);
  }
  .dv__btn {
    margin-top: var(--space-4);
    justify-self: start;
  }
  @media (min-width: 900px) {
    .dv__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
</style>
