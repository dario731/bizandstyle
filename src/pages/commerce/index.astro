---
import DivisionPage from '@components/system/DivisionPage.astro';
import Steps from '@components/editorial/Steps.astro';
import ProseSections from '@components/editorial/ProseSections.astro';
---

<DivisionPage
  division="commerce"
  seo={{ title: 'B&S Commerce · Product to Market | BIZ & STYLE', description: 'Import/export, distribution, marketplaces, bonded warehousing and fulfillment from Miami for the Americas. +1 305-549-4289.' }}
  hero={{ eyebrow: 'Division 02 · B&S Commerce', title: ['From product', 'to market.'], lede: 'Import and export, distribution, marketplaces, domestic and bonded warehousing in Miami, B2B and B2C fulfillment and brand representation — the physical engine that lets an international brand operate in the Americas.', mediaId: 'HOME-DIV-COM' }}
  definition={{
    q: 'What is B&S Commerce?',
    a: [
      'B&S Commerce is the trade and distribution division of BIZ & STYLE. It bridges brands and markets — managing supply chains across duty-free, retail, e-commerce and direct-to-consumer — and acts as the plug-in for international brands entering the Americas: import and export, distribution, marketplace management (Amazon, Shopify, global marketplaces), licensing and representation, domestic and bonded warehousing with B2B and B2C fulfillment, and brand expansion in beauty, food and beverage, accessories and apparel.',
    ],
  }}
  statement={{ lines: ['One warehouse.', 'Two markets.'], body: ['Sell into the U.S. when it makes sense, and distribute across Latin America duty-efficiently — all from a single Miami hub with domestic and bonded storage side by side. Europe → Miami bonded hub → U.S. · LATAM · Caribbean.'] }}
  faqs={[
    { q: 'Which product categories does B&S Commerce work with?', a: 'Beauty and personal care, food and beverage, accessories (watches, jewelry, bags, lifestyle) and apparel — premium consumer brands.' },
    { q: 'Which channels do you distribute through?', a: 'Domestic retail (department stores, malls, chains, drugstores), travel retail (duty-free, cruise lines, in-flight) and e-commerce (brand .com, marketplaces, social commerce).' },
    { q: 'What is the advantage of a bonded warehouse in Miami?', a: 'Duty is deferred until goods enter U.S. commerce; goods re-exported to Latin America or the Caribbean never pay U.S. import duty; goods can be stored, sorted, labelled and repackaged while still in bond.' },
    { q: 'Is Commerce separate from Advisory?', a: 'Same platform. Advisory designs entry and BD; Commerce runs physical trade, warehousing and fulfillment — often together.' },
    { q: 'How do I start?', a: '+1 305-549-4289 or info@bizandstyledna.com.' },
  ]}
  relatedLinks={[
    { href: '/commerce/bonded-warehouse', label: 'Miami bonded warehouse', line: 'Wave 1 primary proof — duty deferral next to PortMiami and MIA.' },
    { href: '/commerce/distribution', label: 'U.S. & LATAM distribution', line: 'Domestic retail, travel retail and e-commerce from one hub.' },
    { href: '/commerce/import-export', label: 'import / export via Miami', line: 'Freight, customs and cross-border setup.' },
    { href: '/commerce/marketplaces', label: 'Amazon & marketplace management', line: 'Listings, inventory and advertising from Miami.' },
    { href: '/miami', label: 'Miami platform to the Americas', line: 'Why the geo hub and the bonded hub are the same decision.' },
    { href: '/divisions', label: 'three engines', line: 'Chooser — Advisory, Commerce or Luxury.' },
  ]}
  schema={{
    pageType: 'CollectionPage',
    serviceName: 'B&S Commerce',
    serviceType: 'Trade / distribution / warehousing',
    areaServed: ['Miami', 'United States', 'Latin America', 'Caribbean', 'Europe'],
    breadcrumbName: 'Commerce',
  }}
  cta={{ eyebrow: 'Looking for U.S. or LATAM distribution?', title: ['Talk to', 'B&S Commerce.'], primary: { label: 'Talk to B&S Commerce', href: '/tell-us?intent=distribution&persona=consumer-brand', name: 'talk_commerce' }, secondary: { label: 'The bonded warehouse', href: '/commerce/bonded-warehouse', name: 'bonded' } }}
>
  <Steps slot="after-services" eyebrow="The journey of a product" title="Europe → Miami bonded hub → U.S. · LATAM · Caribbean" label="Stage" ground="paper" steps={[
    { name: 'Origin', line: 'Freight forwarding by air or ocean from Europe or anywhere in the world.' },
    { name: 'Miami bonded hub', line: 'Held in bond: duty deferred, consolidated, labelled, repackaged — PortMiami and MIA next door.' },
    { name: 'United States', line: 'Released into U.S. commerce when it makes sense — retail, marketplaces, DTC — from domestic storage.' },
    { name: 'LATAM · Caribbean', line: 'Re-exported duty-efficiently to Mexico, the Caribbean, Brazil and the wider region.' },
  ]} />
  <ProseSections slot="after-services" ground="onyx" idPrefix="com" sections={[
    {
      title: 'Categories and channels',
      paragraphs: [
        'Beauty and personal care, food and beverage, accessories and apparel — premium consumer brands. Channels: domestic retail, travel retail and e-commerce, including Amazon and marketplace management from the same Miami inventory.',
        'Duty deferral and bonded storage are why one warehouse can serve two markets: release into the United States when it makes sense; move the rest to Latin America and the Caribbean without U.S. import duty. Same platform as Advisory — entry and BD on one side, physical trade on the other.',
      ],
    },
  ]} />
</DivisionPage>
