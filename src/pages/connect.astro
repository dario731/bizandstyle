---
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/editorial/EditorialHero.astro';
import LeadFormLite from '@components/conversion/LeadFormLite.astro';
import BookingEmbed from '@components/conversion/BookingEmbed.astro';
import ModuleGrid from '@components/editorial/ModuleGrid.astro';
import FaqBlock from '@components/editorial/FaqBlock.astro';
import { pages } from '@i18n/pages.en';
import { site } from '@data/site';
import { webPageLd, breadcrumbLd, faqLd, localBusinessLd, graph, absoluteUrl } from '@lib/seo';

const p = pages.connect;
const path = '/connect';
const jsonLd = graph(
  webPageLd({
    name: p.seo.title,
    description: 'Call, WhatsApp or email BIZ & STYLE at Miami Beach HQ — Thyssen Building, 1000 5th Street Suite 200.',
    path,
    type: 'ContactPage',
  }),
  localBusinessLd(),
  faqLd([...p.faqs], `${absoluteUrl(path)}#faq`),
  breadcrumbLd([{ name: 'Connect', path }]),
);
const f = p.fields;
---

<BaseLayout title={p.seo.title} description={p.seo.description} {path} pageType="conversion" {jsonLd}>
  <EditorialHero eyebrow={p.hero.eyebrow} title={p.hero.title} lede={p.hero.lede} ground="paper" crumbs={[{ name: 'Connect', path }]} />
  <section class="section ground-paper cn">
    <div class="container cn__grid">
      <div class="cn__details" data-reveal-group>
        <div class="cn__block">
          <h2 class="display-3">{p.phone}</h2>
          <a class="cn__big" href={site.phoneHref} data-track="phone_click" data-track-cta-location="connect">{site.phone}</a>
          <a class="link" href={site.whatsappHref} rel="noopener" data-track="whatsapp_click" data-track-cta-location="connect">WhatsApp</a>
          <a class="cn__big" href={`mailto:${site.email}`} data-track="email_click" data-track-cta-location="connect">{site.email}</a>
        </div>
        <div class="cn__block">
          <h2 class="display-3">{p.book}</h2>
          <a class="btn btn--solid" href={site.booking} rel="noopener" data-track="calendar_click" data-track-cta-location="connect">
            <span class="btn__ring" aria-hidden="true"></span>{p.book}
          </a>
        </div>
        <address class="cn__block">
          <h2 class="display-3">{p.hq}</h2>
          <p class="cn__addr">
            {site.legalName}<br />
            {site.address.building}<br />
            {site.address.streetAddress}<br />
            {site.address.addressLocality}, {site.address.addressRegion} {site.address.postalCode}
          </p>
          <a class="link" href={site.address.mapsUrl} rel="noopener">{p.map}</a>
        </address>
        <div class="cn__block cn__alt">
          <h2 class="display-3">Prefer a form? Tell us / Build</h2>
          <p class="small muted">{p.alt.body} Miami Beach is Eastern Time. Florida · Thyssen Building · Americas.</p>
          <a class="link" href="/tell-us" data-track="cta_click" data-track-cta-name="tell_us" data-track-cta-location="connect">{p.alt.cta}</a>
          <a class="link" href="/build" data-track="cta_click" data-track-cta-name="build" data-track-cta-location="connect">build your journey</a>
        </div>
      </div>
      <div class="cn__form">
        <p class="eyebrow eyebrow--marker" data-reveal>{p.formTitle}</p>
        <LeadFormLite
          formId="connect"
          persona="founder"
          intent="other"
          ground="paper"
          fields={[
            { name: 'full_name', label: f.name, required: true, autocomplete: 'name' },
            { name: 'company_name', label: f.company, autocomplete: 'organization' },
            { name: 'email', label: f.email, type: 'email', required: true, autocomplete: 'email' },
            { name: 'phone', label: f.phone, type: 'tel', autocomplete: 'tel' },
            { name: 'message', label: f.message, type: 'textarea', rows: 5, required: true },
          ]}
          submitLabel={p.submit}
          consentLabel={p.consent}
          successTitle={p.success.title}
          successBody={p.success.body}
          errorLabel={p.error}
        />
      </div>
    </div>
  </section>
  <section class="section ground-onyx cn-book" id="book" aria-labelledby="cn-book-title">
    <div class="container">
      <p class="eyebrow eyebrow--marker" data-reveal>DNA Discovery Call</p>
      <h2 id="cn-book-title" class="display-3" data-reveal>Book a 30-minute conversation.</h2>
      <div class="cn__booker">
        <BookingEmbed id="dna-ghl-booking-connect" />
      </div>
    </div>
  </section>
  <ModuleGrid eyebrow="Continue" title="Related on the platform." items={p.relatedLinks.map((l) => ({ name: l.label, line: l.line, href: l.href }))} columns={4} ground="onyx" numbered={false} trackAs="navigation_click" />
  <FaqBlock faqs={p.faqs} title="FAQ" ground="paper" />
</BaseLayout>

<style>
  .cn {
    padding-top: 0;
  }
  .cn__grid {
    display: grid;
    gap: var(--space-8);
  }
  .cn__details {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }
  .cn__block {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-style: normal;
  }
  .cn__big {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 105, 'wght' 600;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    letter-spacing: -0.01em;
    word-break: break-all;
  }
  .cn__addr {
    line-height: 1.5;
  }
  .cn__form {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }
  .cn-book .display-3 {
    margin-block: var(--space-3) var(--space-6);
  }
  .cn__booker {
    width: 100%;
    min-height: max(700px, min(90vh, 900px));
    border: 1px solid rgba(244, 246, 248, 0.1);
    border-radius: 2px;
    overflow-x: hidden;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    background: #0c0d0f;
  }
  .cn__booker iframe {
    display: block;
    width: 100%;
    min-height: max(700px, min(90vh, 900px));
    height: max(700px, min(90vh, 900px));
    border: 0;
    overflow-y: auto;
  }
  @media (min-width: 1024px) {
    .cn__grid {
      grid-template-columns: 5fr 7fr;
      column-gap: calc(var(--gutter) * 2);
    }
  }
</style>
