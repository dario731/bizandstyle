---
import ServicePage from '@components/system/ServicePage.astro';
import { byDivision } from '@data/services';

export function getStaticPaths() {
  return byDivision('luxury').map((s) => ({ params: { service: s.slug }, props: { service: s } }));
}
const { service } = Astro.props;
---

<ServicePage {service} />
