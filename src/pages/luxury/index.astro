---
import DivisionPage from '@components/system/DivisionPage.astro';
import LuxuryEcosystem from '@components/system/LuxuryEcosystem.astro';
import ModuleGrid from '@components/editorial/ModuleGrid.astro';
import Statement from '@components/editorial/Statement.astro';
import { getCopy } from '@i18n/index';
const t = getCopy('en');
---

<DivisionPage
  division="luxury"
  seo={{ title: 'B&S Luxury — Business Development at the Highest Level | BIZ & STYLE', description: 'B&S Luxury: Miami luxury and pre-construction real estate, developer partnerships and a seven-vertical business-development ecosystem serving the same high-net-worth client.' }}
  hero={{ eyebrow: 'Division 03 · B&S Luxury', title: ['Business development', 'at the highest level.'], lede: 'Real estate. Relationships. Business development. Luxury real estate in Miami, developer partnerships and an ecosystem across seven luxury verticals — a platform where relationships compound.', mediaId: 'HOME-DIV-LUX' }}
  definition={{
    q: 'What is B&S Luxury?',
    a: [
      'B&S Luxury is the real-estate and high-value-ecosystem division of BIZ & STYLE — not an isolated real-estate team but a division of a business-development group. It focuses on luxury and ultra-luxury pre-construction opportunities in Miami for international buyers and private clients, develops strategic relationships with leading developers, and builds a business-development ecosystem across seven luxury verticals that serve the same high-net-worth client.',
      'Property search, neighbourhoods and new developments live on the dedicated B&S Luxury site, bns-luxury.com. Investment, wealth structuring and tax matters are coordinated through licensed professionals.',
    ],
  }}
  statement={{ lines: ['Relationships compound.', 'So does business.'], body: ['We do not send a client to someone who needs a jet, a yacht or a table. We work with companies and strategic partners to create business — relationships, partnerships, visibility and commercial opportunity — because they serve the same client we do.'] }}
  faqs={[
    { q: 'Where can I search Miami properties?', a: 'On the dedicated B&S Luxury website, bns-luxury.com — listings, neighbourhood guides and new developments. This corporate site explains the business-development ecosystem behind it.' },
    { q: 'Does B&S Luxury provide investment or tax advice?', a: 'No. Real estate is presented as a stage of the Investor Journey; investment, wealth structuring and tax matters are handled by independent licensed professionals.' },
    { q: 'How do developers work with B&S Luxury?', a: 'Beyond buyer registration: dedicated business-development and marketing programmes with selected luxury developments — proprietary digital acquisition targeting international buyers, events and ecosystem introductions.' },
  ]}
  cta={{ eyebrow: 'Exploring Miami?', title: ['Explore', 'Miami luxury real estate.'], primary: { label: 'Explore luxury real estate ↗', href: 'https://bns-luxury.com', name: 'bns_luxury' }, secondary: { label: "Tell us what you're building", href: '/tell-us', name: 'tell_us' } }}
  servicesTitle="Inside the division"
>
  <LuxuryEcosystem slot="after-hero" copy={t.home.luxury} />
  <Statement slot="after-services" eyebrow="Official website" lines={['Luxury real estate', 'lives on bns-luxury.com.']} body={['Listings, neighbourhood guides, new developments and the B&S Luxury team — on the dedicated site of the division.']} ground="onyx" size="display-2">
    <a class="btn btn--flash" href="https://bns-luxury.com" target="_blank" rel="noopener" data-track="outbound_click" data-track-cta-name="bns_luxury_site">Visit bns-luxury.com</a>
  </Statement>
  <ModuleGrid slot="after-services" eyebrow="Real estate" title="Luxury real estate. Miami." ground="paper" numbered={false} columns={3} items={[
    { name: 'Luxury real estate', line: 'Curated acquisition for international buyers and private clients.', href: 'https://bns-luxury.com' },
    { name: 'Pre-construction', line: 'Early access to luxury and ultra-luxury developments.', href: 'https://bns-luxury.com' },
    { name: 'Developer partnerships', line: 'Strategic relationships with leading developers.', href: '/luxury/developer-partnerships' },
    { name: 'Private clients', line: 'Discreet, deeply personal end-to-end representation.' },
    { name: 'International buyer ecosystem', line: 'The buyer of Miami rarely lives in Miami — local, out of state, international.' },
    { name: 'Digital lead generation & CRM', line: 'Proprietary acquisition and nurturing, built in-house.', href: '/luxury/ecosystem' },
  ]} />
</DivisionPage>
