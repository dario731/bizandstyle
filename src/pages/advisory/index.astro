---
import DivisionPage from '@components/system/DivisionPage.astro';
import InHouseVsPartners from '@components/editorial/InHouseVsPartners.astro';
import ProseSections from '@components/editorial/ProseSections.astro';
---

<DivisionPage
  division="advisory"
  seo={{ title: 'B&S Advisory · Strategy & Growth | BIZ & STYLE', description: 'Strategy that ends in execution: international expansion, fractional leadership, BD and digital — Miami. +1 305-549-4289.' }}
  hero={{ eyebrow: 'Division 01 · B&S Advisory', title: ['Strategy that', 'ends in execution.'], lede: 'Business strategy, international expansion, fractional executive leadership, business development and digital growth — delivered by a team that operates in-market rather than advising from a distance. Miami Beach, United States, Latin America and Europe.', mediaId: 'HOME-DIV-ADV' }}
  definition={{
    q: 'What is B&S Advisory?',
    a: [
      'B&S Advisory is the strategy and growth division of BIZ & STYLE. It covers business strategy and go-to-market, internationalization (U.S. market entry, LATAM expansion, temporary export management, local representation, trade missions, partner development), fractional executive services, business development and partnership engineering, and digital growth — websites, lead generation, Google and Meta, SEO and GEO, CRM, automation, analytics and AI-enabled workflows.',
      'It is not PowerPoint strategy. The same team connects strategy with execution through B&S Commerce, the digital engine and the commercial network. Financial and wealth advisory, tax and legal are delivered through a vetted network of licensed professionals.',
    ],
  }}
  statement={{ lines: ['Operators in-market —', 'not advisors at a distance.'], body: ['The engine behind business transformation: helping companies navigate complexity with precision and agility, from first feasibility study to full international deployment — and staying to run it from Miami.'] }}
  faqs={[
    { q: 'Which industries does B&S Advisory serve?', a: 'Premium consumer goods (beauty, food and beverage, accessories, apparel), luxury and real estate, and companies expanding between Europe, the United States and Latin America.' },
    { q: 'How does an engagement start?', a: 'With a strategic conversation. Once we understand your goals we design a roadmap and a clear proposal — scope, deliverables, timeline, and who delivers what.' },
    { q: 'Does B&S Advisory provide financial, tax or legal advice?', a: 'No. Those are delivered by independent licensed professionals from our network, coordinated by us.' },
    { q: 'Where does digital growth live?', a: 'Primary commercial story: `/digital-engine`. Packaged offer: `/programs/digital-growth-engine`. Advisory digital-growth URL is demoted.' },
    { q: 'Fractional — capability or programme?', a: 'Capability explainer: `/advisory/fractional-executive`. Packaged programme (primary commercial): `/programs/fractional-executive`.' },
  ]}
  extraCapabilities={[
    { name: 'Digital Engine', line: 'Digital business infrastructure — from click to client. The primary commercial story for digital growth; the Advisory digital-growth URL is demoted.', href: '/digital-engine' },
  ]}
  insightsCluster={['/lead-generation']}
  relatedLinks={[
    { href: '/advisory/international-expansion', label: 'international expansion service', line: 'U.S. and LATAM expansion — the service, not the hub.' },
    { href: '/advisory/business-development', label: 'business development', line: 'Partner scouting, key accounts, trade missions.' },
    { href: '/advisory/partnership-engineering', label: 'partnership engineering', line: 'JVs, licensing, distribution — commercial logic first.' },
    { href: '/advisory/crm-automation', label: 'CRM & automation', line: 'Capability that feeds the Digital Engine.' },
    { href: '/advisory/fractional-executive', label: 'fractional executive capability', line: 'What a fractional executive is — the explainer.' },
    { href: '/programs/fractional-executive', label: 'Fractional Executive programme', line: 'The packaged commercial offer — primary fractional URL.' },
    { href: '/digital-engine', label: 'Digital Engine', line: 'Primary digital commercial story — not a competing leaf.' },
    { href: '/programs', label: 'signature programmes', line: 'Exactly three packaged offers.' },
  ]}
  schema={{
    pageType: 'CollectionPage',
    serviceName: 'B&S Advisory',
    serviceType: 'Business advisory / growth strategy',
    areaServed: ['Miami', 'United States', 'Latin America', 'Europe'],
    breadcrumbName: 'Advisory',
  }}
  cta={{ eyebrow: 'Building something in the Americas?', title: ['Tell us', "what you're building."], primary: { label: "Tell us what you're building", href: '/tell-us?intent=business-development', name: 'tell_us' }, secondary: { label: 'Assess your market entry', href: '/tell-us?intent=market-entry&persona=international-company', name: 'assess_market_entry' } }}
>
  <InHouseVsPartners slot="after-services" ground="onyx" title="What BIZ & STYLE executes directly vs licensed professionals" />
  <ProseSections slot="after-services" ground="paper" idPrefix="adv" sections={[
    {
      title: 'From capability to signature programme',
      paragraphs: [
        'Capability pages explain how we work. Signature programmes package selected capabilities into a named engagement — International Expansion Boost™, Digital Growth Engine™, Fractional Executive. Start with the capability when you are mapping; start with a programme when you are ready to buy a scoped offer.',
        'Digital growth is the exception that proves the IA: the primary commercial story is the Digital Engine; the packaged offer is Digital Growth Engine™; the old Advisory digital-growth URL is demoted. Fractional keeps both a capability explainer and a programme primary.',
      ],
    },
  ]} />
</DivisionPage>
