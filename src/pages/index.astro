---
import BaseLayout from '@layouts/BaseLayout.astro';
import CineHero from '@components/home2/CineHero.astro';
import EnginesConnected from '@components/home2/EnginesConnected.astro';
import OrbitCarousel from '@components/cinematic/OrbitCarousel.astro';
import WorldConnect from '@components/home2/WorldConnect.astro';
import JourneyLoop from '@components/home2/JourneyLoop.astro';
import CaptureBand from '@components/home2/CaptureBand.astro';
import { getCopy } from '@i18n/index';
import { site } from '@data/site';
import { solutions } from '@data/solutions';

const t = getCopy('en');
const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${site.url}/#webpage`,
    url: site.url,
    name: t.meta.home.title,
    description: t.meta.home.description,
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': `${site.url}/#organization` },
    inLanguage: 'en',
  },
];

const orbitItems = solutions.map((s) => ({ num: s.num, name: s.name, line: s.tagline, href: `/solutions#${s.slug}`, tag: 'Solution' }));
---

<BaseLayout title={t.meta.home.title} description={t.meta.home.description} path="/" pageType="home" {jsonLd}>
  <CineHero />
  <EnginesConnected />
  <OrbitCarousel eyebrow="Solutions" title={['Five solutions.', 'Integrated or à la carte.']} items={orbitItems} id="orbit" />
  <WorldConnect />
  <JourneyLoop />
  <CaptureBand />
</BaseLayout>
