---
import BaseLayout from '@layouts/BaseLayout.astro';
import DynamicLeadForm from '@components/conversion/DynamicLeadForm.astro';
import ProseSections from '@components/editorial/ProseSections.astro';
import ModuleGrid from '@components/editorial/ModuleGrid.astro';
import FaqBlock from '@components/editorial/FaqBlock.astro';
import { pages } from '@i18n/pages.en';
import { getCopy } from '@i18n/index';
import { site } from '@data/site';
import { webPageLd, breadcrumbLd, faqLd, graph, absoluteUrl } from '@lib/seo';

const p = pages.tellUs;
const t = getCopy('en');
const path = '/tell-us';
const jsonLd = graph(
  webPageLd({
    name: p.seo.title,
    description: "Tell us where you are and where you're going — international company, brand, founder, developer, investor or partner.",
    path,
    type: 'ContactPage',
  }),
  faqLd([...p.faqs], `${absoluteUrl(path)}#faq`),
  breadcrumbLd([{ name: 'Tell Us', path }]),
);
---

<BaseLayout title={p.seo.title} description={p.seo.description} {path} pageType="conversion" {jsonLd}>
  <div class="tu-top ground-onyx"></div>
  <DynamicLeadForm copy={{ ...t.home.tellUs, eyebrow: 'Who you are' }} id="tell-us-page" headingLevel="h1" />
  <ProseSections sections={p.sections} ground="paper" idPrefix="tell-us" />
  <section class="section--tight ground-onyx tu-alt">
    <div class="container tu-alt__grid">
      <p class="small muted">Prefer a conversation? <a class="link" href={site.calendly} rel="noopener" data-track="calendar_click" data-track-cta-location="tell_us">Book a call</a></p>
      <p class="small muted"><a href={`mailto:${site.email}`} data-track="email_click">{site.email}</a> · <a href={site.phoneHref} data-track="phone_click">{site.phone}</a></p>
    </div>
  </section>
  <ModuleGrid eyebrow="Continue" title="Related on the platform." items={p.relatedLinks.map((l) => ({ name: l.label, line: l.line, href: l.href }))} columns={3} ground="paper" numbered={false} trackAs="navigation_click" />
  <FaqBlock faqs={p.faqs} title="FAQ" ground="onyx" />
</BaseLayout>

<style>
  .tu-top {
    height: 4.5rem;
  }
  .tu-alt {
    padding-block: var(--space-6) var(--space-8);
    border-top: 1px solid var(--rule-deep);
  }
  .tu-alt__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .tu-alt .link {
    margin-left: 0.5rem;
  }
</style>
