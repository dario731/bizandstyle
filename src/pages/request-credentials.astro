---
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/editorial/EditorialHero.astro';
import LeadFormLite from '@components/conversion/LeadFormLite.astro';
import ProseSections from '@components/editorial/ProseSections.astro';
import ModuleGrid from '@components/editorial/ModuleGrid.astro';
import FaqBlock from '@components/editorial/FaqBlock.astro';
import { pages } from '@i18n/pages.en';
import { webPageLd, breadcrumbLd, faqLd, graph, absoluteUrl } from '@lib/seo';

const p = pages.credentials;
const path = '/request-credentials';
const jsonLd = graph(
  webPageLd({ name: p.seo.title, description: p.seo.description, path, type: ['WebPage', 'ContactPage'] }),
  faqLd([...p.faqs], `${absoluteUrl(path)}#faq`),
  breadcrumbLd([{ name: 'Request Credentials', path }]),
);
const f = p.fields;
---

<BaseLayout title={p.seo.title} description={p.seo.description} {path} pageType="conversion" {jsonLd} noindex={false}>
  <EditorialHero eyebrow={p.hero.eyebrow} title={p.hero.title} lede={p.hero.lede} ground="onyx" crumbs={[{ name: 'Request Credentials', path }]} />
  <section class="section ground-onyx rc">
    <div class="container rc__grid">
      <div class="rc__side" data-reveal>
        <h2 class="display-3">Under NDA where appropriate</h2>
        <p class="editorial">Not every relationship belongs on a website.</p>
        <p class="small muted">Tell us what you are evaluating. We share what is relevant — and only what our clients and partners have agreed to share.</p>
      </div>
      <LeadFormLite
        formId="credentials"
        persona="us-company"
        intent="other"
        fields={[
          { name: 'full_name', label: f.name, required: true, autocomplete: 'name' },
          { name: 'company_name', label: f.company, required: true, autocomplete: 'organization' },
          { name: 'role', label: f.role },
          { name: 'email', label: f.email, type: 'email', required: true, autocomplete: 'email' },
          { name: 'area', label: f.area, type: 'chips', options: p.areas, multiple: true },
          { name: 'message', label: f.context, type: 'textarea', rows: 4, required: true },
        ]}
        submitLabel={p.submit}
        consentLabel={p.consent}
        successTitle={p.success.title}
        successBody={p.success.body}
        errorLabel={p.error}
      />
    </div>
  </section>
  <ProseSections sections={p.sections} ground="paper" idPrefix="credentials" />
  <ModuleGrid eyebrow="Continue" title="Related on the platform." items={p.relatedLinks.map((l) => ({ name: l.label, line: l.line, href: l.href }))} columns={4} ground="onyx" numbered={false} trackAs="navigation_click" />
  <FaqBlock faqs={p.faqs} title="FAQ" ground="paper" />
</BaseLayout>

<style>
  .rc {
    padding-top: 0;
  }
  .rc__grid {
    display: grid;
    gap: var(--space-8);
  }
  .rc__side {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  @media (min-width: 1024px) {
    .rc__grid {
      grid-template-columns: 4fr 8fr;
      column-gap: calc(var(--gutter) * 2);
    }
    .rc__side {
      position: sticky;
      top: 7rem;
    }
  }
</style>
