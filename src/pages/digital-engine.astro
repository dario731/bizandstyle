---
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/editorial/EditorialHero.astro';
import Definition from '@components/editorial/Definition.astro';
import DigitalEngine from '@components/system/DigitalEngine.astro';
import ModuleGrid from '@components/editorial/ModuleGrid.astro';
import ProseSections from '@components/editorial/ProseSections.astro';
import Statement from '@components/editorial/Statement.astro';
import FaqBlock from '@components/editorial/FaqBlock.astro';
import ContextualCta from '@components/conversion/ContextualCta.astro';
import RelatedInsights from '@components/insights/RelatedInsights.astro';
import { pages } from '@i18n/pages.en';
import { getCopy } from '@i18n/index';
import { byDivision, servicePath } from '@data/services';
import { webPageLd, breadcrumbLd, faqLd, serviceLd, graph, absoluteUrl } from '@lib/seo';

const p = pages.digitalEngine;
const t = getCopy('en');
const path = '/digital-engine';
const digitalServices = byDivision('advisory').filter((s) => ['lead-generation', 'crm-automation', 'ai-digital-transformation'].includes(s.slug));
const jsonLd = graph(
  webPageLd({ name: p.seo.title, description: p.seo.description, path }),
  serviceLd({
    name: 'BIZ & STYLE Digital Engine',
    description: p.definition.a[0],
    path,
    serviceType: 'Digital business infrastructure / owned acquisition system',
    areaServed: ['Miami', 'United States', 'Latin America', 'Americas'],
    knowsAbout: ['SEO', 'GEO', 'Google Ads', 'Meta Ads', 'CRM', 'Lead capture', 'Conversion optimization'],
  }),
  breadcrumbLd([{ name: 'Digital Engine', path }]),
  faqLd([...p.faqs], `${absoluteUrl(path)}#faq`),
);
---

<BaseLayout title={p.seo.title} description={p.seo.description} {path} pageType="landing" {jsonLd}>
  <EditorialHero eyebrow={p.hero.eyebrow} title={p.hero.title} lede={p.hero.lede} ground="onyx" crumbs={[{ name: 'Digital Engine', path }]}>
    <a class="btn btn--solid" href={p.cta.primary.href} data-track="cta_click" data-track-cta-name="digital_growth_review" data-track-cta-location="landing_hero">
      <span class="btn__ring" aria-hidden="true"></span>{p.cta.primary.label}
    </a>
  </EditorialHero>
  <DigitalEngine copy={{ ...t.home.digital, eyebrow: 'The loop', title: 'From click to client — the loop.' }} />
  <Definition question={p.definition.q} answer={p.definition.a} ground="paper" id="definition" />
  <ModuleGrid
    eyebrow="Capabilities"
    title="Digital growth services."
    items={[
      { name: 'Digital Growth Engine™ programme', line: 'The packaged programme that builds the owned loop.', href: '/programs/digital-growth-engine' },
      ...digitalServices.map((s) => ({ name: s.title, line: s.lede, href: servicePath(s) })),
    ]}
    columns={4}
    ground="paper"
    numbered={false}
    trackAs="service_view"
  />
  <Statement lines={['Proof —', 'B&S Luxury runs on this engine.']} ground="onyx" body={['Proprietary digital acquisition generated high-net-worth opportunities in some of the most relationship-driven segments of the Miami market — proof that the system works before it is offered to clients. Google, Meta, SEO and GEO with international targeting, built in-house.']} />
  <ProseSections sections={p.leadGen ? [p.leadGen] : []} ground="paper" idPrefix="de-lead" />
  <ModuleGrid eyebrow="Continue" title="Related on the platform." items={p.links.map((l) => ({ name: l.label, line: l.line, href: l.href }))} columns={4} ground="onyx" numbered={false} trackAs="navigation_click" />
  <RelatedInsights clusterOf={[path, '/lead-generation', '/advisory/lead-generation', '/advisory/ai-digital-transformation']} ground="paper" />
  <FaqBlock faqs={p.faqs} title="FAQ" ground="paper" />
  <ContextualCta eyebrow={p.cta.eyebrow} title={p.cta.title} primary={p.cta.primary} secondary={p.cta.secondary} location="landing_cta" />
</BaseLayout>
