---
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/editorial/EditorialHero.astro';
import OrbitCarousel from '@components/cinematic/OrbitCarousel.astro';
import FaqBlock from '@components/editorial/FaqBlock.astro';
import ContextualCta from '@components/conversion/ContextualCta.astro';
import { solutions, solutionsIntro } from '@data/solutions';
import { webPageLd, breadcrumbLd, serviceLd, faqLd, graph } from '@lib/seo';

const path = '/solutions';
const title = 'Solutions — Tested, Turnkey Solutions Engineered for Results | BIZ & STYLE';
const description = 'Five core solution categories — management & business development, corporate setup & legal, logistics & operations, relocation & immigration, real estate, wealth & lifestyle — as an integrated ecosystem or à la carte.';
const faqs = [
  { q: 'Can I use a single solution, or do I need the full program?', a: 'Both. The five categories work as an integrated ecosystem or as standalone, à la carte services — the right tools at the right time.' },
  { q: 'Who delivers the legal, tax and immigration work?', a: 'Independent licensed lawyers, accountants, immigration attorneys and banking partners in our vetted network. BIZ & STYLE coordinates the sequence; they deliver and remain responsible for their services.' },
  { q: 'Where is the warehousing?', a: 'Domestic and bonded facilities in Miami — the gateway to the United States and Latin America.' },
];
const jsonLd = graph(
  webPageLd({ name: title, description, path, type: 'CollectionPage' }),
  ...solutions.map((s) => serviceLd({ name: s.name, description: s.tagline, path: `${path}#${s.slug}` })),
  breadcrumbLd([{ name: 'Solutions', path }]),
  faqLd(faqs),
);
---

<BaseLayout {title} {description} {path} pageType="solutions" {jsonLd}>
  <EditorialHero eyebrow="Solutions" title={solutionsIntro.title} ground="onyx" crumbs={[{ name: 'Solutions', path }]} size="display-2" toc={false} tight />

  <section class="ground-onyx sol-tiles" aria-label="The five solutions">
    <div class="container">
    <ol class="sol-tiles__grid" role="list" data-sol-tiles>
      {solutions.map((s, i) => (
        <li>
          <a class="sol-tile" href={`#${s.slug}`} data-sol-tile={s.slug} aria-current={i === 0 ? 'true' : undefined} data-track="navigation_click" data-track-cta-name={s.name}>
            <span class="sol-tile__top"><span class="num">{s.num}</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></span>
            <span class="sol-tile__name">{s.name}</span>
            <span class="sol-tile__line">{s.tagline}</span>
          </a>
        </li>
      ))}
    </ol>
    </div>
  </section>

  <OrbitCarousel
    eyebrow="Inside each solution"
    title={['Swipe through', 'everything included.']}
    items={solutions.map((s) => ({ num: s.num, name: s.name, line: s.tagline, href: `#${s.slug}`, tag: 'Solution' }))}
    details={solutions.map((s) => ({ intro: s.intro, groups: s.groups, note: s.note ? (s.regulated ? `Delivered with licensed professionals · ${s.note}` : s.note) : undefined, href: s.href }))}
    id="five-ways"
  />

  <section class="section--tight ground-paper sol-intro" id="capabilities" aria-labelledby="cap-title">
    <div class="container sol-intro__grid">
      <h2 id="cap-title" class="display-3" data-reveal>Our core capabilities</h2>
      <p class="prose muted" data-reveal>{solutionsIntro.capabilities}</p>
    </div>
  </section>

  <FaqBlock {faqs} ground="paper" />
  <ContextualCta eyebrow="Ready to transform ambition into reality?" title={['Schedule', 'a consultation.']} body="Our team is ready to build your customised growth solution. Whether you need a single service or a fully integrated program, we provide the expertise and infrastructure to help you succeed in new markets." primary={{ label: 'Schedule a consultation', href: '#connect', name: 'schedule_consultation' }} secondary={{ label: "Tell us what you're building", href: '/tell-us', name: 'tell_us' }} location="solutions_cta" />
</BaseLayout>

<style>
  .sol-tiles { padding-block: 0 var(--space-6); }
  .sol-tiles__grid {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .sol-tiles__grid li:last-child { grid-column: 1 / -1; }
  .sol-tile {
    position: relative;
    display: grid;
    gap: 0.55rem;
    align-content: start;
    height: 100%;
    min-height: 9.5rem;
    padding: 1rem 1rem 1.1rem;
    border: 1px solid rgba(244, 246, 248, 0.14);
    border-top: 2px solid rgba(244, 246, 248, 0.28);
    border-radius: 2px;
    background: linear-gradient(170deg, #1a1e25, #0b0d11 70%);
    transition: transform 0.4s var(--ease-out), border-color 0.3s, background 0.3s, box-shadow 0.3s;
  }
  .sol-tile:hover { transform: translateY(-4px); border-color: rgba(244, 246, 248, 0.4); }
  .sol-tile[aria-current='true'] {
    border-color: rgba(244, 246, 248, 0.32);
    border-top: 2px solid transparent;
    border-image: var(--silver-grad) 1;
    background: linear-gradient(170deg, #2a2f38, #12151a 70%);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  }
  .sol-tile__top { display: flex; justify-content: space-between; align-items: center; }
  .sol-tile__top svg { width: 1rem; height: 1rem; color: var(--stone); transition: transform 0.3s var(--ease-out), color 0.3s; }
  .sol-tile:hover .sol-tile__top svg, .sol-tile[aria-current='true'] .sol-tile__top svg { color: var(--paper); transform: translateX(3px); }
  .sol-tile__name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 114, 'wght' 720;
    font-stretch: 114%;
    font-size: clamp(0.95rem, 1.1vw, 1.15rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .sol-tile__line { font-size: 0.8rem; line-height: 1.4; color: var(--stone); }
  :global(#five-ways) { padding-top: var(--space-4); }
  @media (min-width: 900px) {
    .sol-tiles__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.8rem; }
    .sol-tiles__grid li:last-child { grid-column: auto; }
  }
  @media (max-width: 720px) {
    .sol-tiles { padding-bottom: var(--space-5); }
    .sol-tile { min-height: 0; padding: 0.8rem 0.85rem 0.9rem; gap: 0.4rem; }
    .sol-tile__line { display: none; }
  }
  .sol-intro {
    padding-block: var(--space-6);
    border-top: 1px solid var(--rule);
  }
  .sol-intro__grid {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 900px) {
    .sol-intro__grid { grid-template-columns: 4fr 8fr; column-gap: calc(var(--gutter) * 2); }
  }
</style>

<script>
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-sol-tile]'));
  const mark = (slug: string) => {
    if (!tiles.some((t) => t.dataset.solTile === slug)) return;
    tiles.forEach((t) => (t.dataset.solTile === slug ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
  };
  tiles.forEach((t) => t.addEventListener('click', () => mark(t.dataset.solTile || '')));
  window.addEventListener('hashchange', () => mark(decodeURIComponent(location.hash.replace('#', ''))));
  mark(decodeURIComponent(location.hash.replace('#', '')));
</script>
