---
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/editorial/EditorialHero.astro';
import OrbitCarousel from '@components/cinematic/OrbitCarousel.astro';
import FaqBlock from '@components/editorial/FaqBlock.astro';
import ContextualCta from '@components/conversion/ContextualCta.astro';
import { solutions, solutionsIntro } from '@data/solutions';
import { webPageLd, breadcrumbLd, serviceLd, faqLd, graph } from '@lib/seo';

const path = '/solutions';
const title = 'Solutions — Tested, Turnkey Solutions Engineered for Results | BIZ & STYLE';
const description = 'Five core solution categories — management & business development, corporate setup & legal, logistics & operations, relocation & immigration, real estate, wealth & lifestyle — as an integrated ecosystem or à la carte.';
const faqs = [
  { q: 'Can I use a single solution, or do I need the full program?', a: 'Both. The five categories work as an integrated ecosystem or as standalone, à la carte services — the right tools at the right time.' },
  { q: 'Who delivers the legal, tax and immigration work?', a: 'Independent licensed lawyers, accountants, immigration attorneys and banking partners in our vetted network. BIZ & STYLE coordinates the sequence; they deliver and remain responsible for their services.' },
  { q: 'Where is the warehousing?', a: 'Domestic and bonded facilities in Miami — the gateway to the United States and Latin America.' },
];
const jsonLd = graph(
  webPageLd({ name: title, description, path, type: 'CollectionPage' }),
  ...solutions.map((s) => serviceLd({ name: s.name, description: s.tagline, path: `${path}#${s.slug}` })),
  breadcrumbLd([{ name: 'Solutions', path }]),
  faqLd(faqs),
);
---

<BaseLayout {title} {description} {path} pageType="solutions" {jsonLd}>
  <EditorialHero eyebrow="Solutions" title={solutionsIntro.title} lede={solutionsIntro.lede} ground="onyx" mediaId="SOLUTIONS" visual="flow" crumbs={[{ name: 'Solutions', path }]}>
    <button class="btn btn--flash" type="button" data-open-contact="call" data-track="calendar_click" data-track-cta-location="solutions_hero">Schedule a consultation</button>
  </EditorialHero>

  <section class="section--tight ground-paper sol-intro">
    <div class="container sol-intro__grid">
      <h2 class="display-3" data-reveal>Our core capabilities</h2>
      <p class="prose" data-reveal>{solutionsIntro.capabilities}</p>
    </div>
  </section>

  <OrbitCarousel eyebrow="Explore" title={['Five ways', 'to start.']} items={solutions.map((s) => ({ num: s.num, name: s.name, line: s.tagline, href: `#${s.slug}` }))} id="solutions-orbit" />

  {
    solutions.map((s) => (
      <section class="section ground-paper sol" id={s.slug} aria-labelledby={`${s.slug}-title`}>
        <div class="container sol__grid">
          <div class="sol__head">
            <p class="num" data-reveal>Solution {s.num}</p>
            <h2 id={`${s.slug}-title`} class="display-2" data-reveal>{s.name}</h2>
            <p class="editorial sol__tag" data-reveal>{s.tagline}</p>
            <a class="link" href={s.href} data-reveal data-track="navigation_click" data-track-cta-name={s.name}>
              On the platform<svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </a>
          </div>
          <div class="sol__body">
            <p class="prose" data-reveal>{s.intro}</p>
            <div class="sol__groups" data-reveal-group>
              {s.groups.map((g) => (
                <div class="sol__group">
                  <h3 class="eyebrow">{g.title}</h3>
                  <ul role="list">{g.items.map((it) => <li>{it}</li>)}</ul>
                </div>
              ))}
            </div>
            {s.note && (
              <p class:list={['sol__note small', { 'sol__note--reg': s.regulated }]} data-reveal>
                {s.regulated && <span class="eyebrow">Delivered with licensed professionals · </span>}
                {s.note}
              </p>
            )}
          </div>
        </div>
      </section>
    ))
  }

  <FaqBlock {faqs} ground="paper" />
  <ContextualCta eyebrow="Ready to transform ambition into reality?" title={['Schedule', 'a consultation.']} body="Our team is ready to build your customised growth solution. Whether you need a single service or a fully integrated program, we provide the expertise and infrastructure to help you succeed in new markets." primary={{ label: 'Schedule a consultation', href: '#connect', name: 'schedule_consultation' }} secondary={{ label: "Tell us what you're building", href: '/tell-us', name: 'tell_us' }} location="solutions_cta" />
</BaseLayout>

<style>
  .sol-intro {
    padding-block: var(--space-7);
    border-top: 1px solid var(--line);
  }
  .sol-intro__grid {
    display: grid;
    gap: var(--space-4);
  }
  .sol {
    border-top: 1px solid var(--line);
    scroll-margin-top: 5rem;
  }
  .sol__grid {
    display: grid;
    gap: var(--space-6);
  }
  .sol__head {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
  }
  .sol__tag {
    color: var(--smoke);
  }
  .sol__body {
    display: grid;
    gap: var(--space-6);
  }
  .sol__groups {
    display: grid;
    gap: var(--space-5);
  }
  .sol__group {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .sol__group li {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .sol__note {
    padding: var(--space-4);
    background: var(--surface);
    border-left: 2px solid var(--brass);
    color: var(--smoke);
    max-width: 78ch;
  }
  .sol__note .eyebrow {
    color: var(--brass);
  }
  @media (min-width: 900px) {
    .sol-intro__grid { grid-template-columns: 4fr 8fr; column-gap: calc(var(--gutter) * 2); }
    .sol__grid { grid-template-columns: 4fr 8fr; column-gap: calc(var(--gutter) * 2); }
    .sol__head { position: sticky; top: 6rem; }
    .sol__groups { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
