---
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/editorial/EditorialHero.astro';
import InHouseVsPartners from '@components/editorial/InHouseVsPartners.astro';
import ProseSections from '@components/editorial/ProseSections.astro';
import Steps from '@components/editorial/Steps.astro';
import ModuleGrid from '@components/editorial/ModuleGrid.astro';
import FaqBlock from '@components/editorial/FaqBlock.astro';
import ContextualCta from '@components/conversion/ContextualCta.astro';
import RealWorld from '@components/home/RealWorld.astro';
import { pages } from '@i18n/pages.en';
import { getCopy } from '@i18n/index';
import { webPageLd, breadcrumbLd, faqLd, graph, absoluteUrl } from '@lib/seo';

const p = pages.howWeWork;
const t = getCopy('en');
const path = '/platform/how-we-work';
const jsonLd = graph(
  webPageLd({
    name: p.seo.title,
    description: 'Every capability is built, operated and tested in our own ventures first — then offered to clients from Miami Beach.',
    path,
  }),
  faqLd([...p.faqs], `${absoluteUrl(path)}#faq`),
  breadcrumbLd([{ name: 'Platform', path: '/platform' }, { name: 'How We Work', path }]),
);
---

<BaseLayout title={p.seo.title} description={p.seo.description} {path} pageType="hub" {jsonLd}>
  <EditorialHero eyebrow={p.hero.eyebrow} title={p.hero.title} lede={p.hero.lede} ground="paper" crumbs={[{ name: 'Platform', path: '/platform' }, { name: 'How We Work', path }]} />
  <InHouseVsPartners ground="paper" title={p.inHouseTitle} />
  <RealWorld copy={{ ...t.home.realWorld, eyebrow: 'The operator philosophy' }} />
  <ProseSections sections={p.sections} ground="onyx" idPrefix="how-we-work" />
  <Steps eyebrow={p.process.eyebrow} title={p.process.title} steps={p.process.steps} label="Step" ground="paper" id="process" />
  <ModuleGrid eyebrow="Continue" title="Related on the platform." items={p.relatedLinks.map((l) => ({ name: l.label, line: l.line, href: l.href }))} columns={3} ground="onyx" numbered={false} trackAs="navigation_click" />
  <FaqBlock faqs={p.faqs} title="FAQ" ground="paper" />
  <ContextualCta eyebrow={p.cta.eyebrow} title={p.cta.title} primary={p.cta.primary} secondary={p.cta.secondary} location="hub_cta" />
</BaseLayout>
