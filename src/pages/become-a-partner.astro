---
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/editorial/EditorialHero.astro';
import LeadFormLite from '@components/conversion/LeadFormLite.astro';
import { pages } from '@i18n/pages.en';
import { webPageLd, breadcrumbLd, graph } from '@lib/seo';

const p = pages.becomePartner;
const path = '/become-a-partner';
const jsonLd = graph(webPageLd({ name: p.seo.title, description: p.seo.description, path, type: 'ContactPage' }), breadcrumbLd([{ name: 'Become a partner', path }]));
const f = p.fields;
---

<BaseLayout title={p.seo.title} description={p.seo.description} {path} pageType="conversion" {jsonLd}>
  <EditorialHero eyebrow={p.hero.eyebrow} title={p.hero.title} lede={p.hero.lede} ground="onyx" crumbs={[{ name: 'Become a partner', path }]} />
  <section class="section ground-onyx pf">
    <div class="container pf__grid">
      <div class="pf__side" data-reveal>
        <p class="eyebrow eyebrow--marker">{p.formTitle}</p>
        <p class="editorial">Relationships are capital. Discretion is part of the relationship.</p>
        <p class="small muted">We review every inquiry personally. Where ecosystems intersect, relationships may be governed by business-development agreements.</p>
      </div>
      <LeadFormLite
        formId="partner"
        persona="partner"
        intent="partnership"
        fields={[
          { name: 'company_name', label: f.company, required: true, autocomplete: 'organization' },
          { name: 'full_name', label: f.name, required: true, autocomplete: 'name' },
          { name: 'email', label: f.email, type: 'email', required: true, autocomplete: 'email' },
          { name: 'phone', label: f.phone, type: 'tel', autocomplete: 'tel' },
          { name: 'website', label: f.website, type: 'url' },
          { name: 'geography', label: f.geography },
          { name: 'industry', label: f.industry, type: 'chips', options: p.industries },
          { name: 'capabilities', label: f.capabilities, type: 'textarea', rows: 2 },
          { name: 'bring', label: f.bring, type: 'textarea', rows: 2 },
          { name: 'build', label: f.build, type: 'textarea', rows: 3, required: true },
        ]}
        submitLabel={p.submit}
        consentLabel={p.consent}
        successTitle={p.success.title}
        successBody={p.success.body}
        errorLabel={p.error}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .pf {
    padding-top: 0;
  }
  .pf__grid {
    display: grid;
    gap: var(--space-8);
  }
  .pf__side {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  @media (min-width: 1024px) {
    .pf__grid {
      grid-template-columns: 4fr 8fr;
      column-gap: calc(var(--gutter) * 2);
    }
    .pf__side {
      position: sticky;
      top: 7rem;
    }
  }
</style>
