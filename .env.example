# Public — injected at build time. Leave empty until GTM is configured.
PUBLIC_GTM_ID=

# Server only — optional secondary forward after the GHL write
# (Follow Up Boss, HubSpot, Zapier/Make…). Empty = skip; GHL is primary.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=

# GoHighLevel Private Integration — required for /api/lead (fail closed).
# Preview deploys without these return 503 { ok: false, error: "ghl_not_configured" }.
GHL_LOCATION_ID=
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_PIPELINE_ID_DEFAULT=
GHL_STAGE_ID_DISCOVERY=
GHL_STAGE_ID_NEW=

# Optional per-ICP pipeline/stage routing (used only when BOTH matching vars are set).
GHL_PIPELINE_ID_INVESTOR=
GHL_STAGE_ID_INVESTOR=
GHL_PIPELINE_ID_EXEC_RELOCATOR=
GHL_STAGE_ID_EXEC_RELOCATOR=
GHL_PIPELINE_ID_INTRA_COMPANY=
GHL_STAGE_ID_INTRA_COMPANY=
GHL_PIPELINE_ID_DEVELOPER=
GHL_STAGE_ID_DEVELOPER=
GHL_PIPELINE_ID_AVIATION=
GHL_STAGE_ID_AVIATION=
GHL_PIPELINE_ID_OVERSEAS=
GHL_STAGE_ID_OVERSEAS=
